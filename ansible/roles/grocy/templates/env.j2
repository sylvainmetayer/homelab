PUID={{ ansible_facts['user_uid'] }}
PGID={{ ansible_facts['user_gid'] }}
TZ=Europe/Paris
# Réglages de Grocy (grocy_settings, defaults/main.yml).
{% if grocy_proxy_auth_enabled | bool %}
# Authentification par l'en-tête Remote-User de Pangolin (defaults/main.yml).
GROCY_AUTH_CLASS=Grocy\Middleware\Auth\ReverseProxyAuthMiddleware
GROCY_REVERSE_PROXY_AUTH_HEADER=Remote-User
{% endif %}
{% for name, value in grocy_settings | dictsort %}
GROCY_{{ name }}={{ (value | string | lower) if value is boolean else value }}
{% endfor %}
