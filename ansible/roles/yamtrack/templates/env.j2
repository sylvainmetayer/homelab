TZ={{ yamtrack_timezone }}
PUID={{ ansible_facts['user_uid'] }}
PGID={{ ansible_facts['user_gid'] }}

# Sessions et jetons signés (dérivé de backup_passphrase, defaults/main.yml) :
# sans lui l'image retombe sur une clé publique.
SECRET={{ yamtrack_secret }}

# Redis du compose, sur le réseau interne.
REDIS_URL=redis://yamtrack-redis:6379

# Origine publique : CSRF et ALLOWED_HOSTS (Django refuse les POST d'une
# origine non listée derrière un proxy).
URLS=https://{{ yamtrack_domain }}

# Le SSO de Pangolin est la première porte ; pas d'inscription libre derrière
# (defaults/main.yml pour créer un compte). Pas d'interface d'admin Django.
REGISTRATION={{ 'True' if yamtrack_registration_enabled | bool else 'False' }}
ADMIN_ENABLED=False
{% if yamtrack_oidc_enabled | bool %}

# Pocket ID (defaults/main.yml) ; rappel
# /accounts/oidc/pocket-id/login/callback/, en https grâce à URLS.
SOCIAL_PROVIDERS=allauth.socialaccount.providers.openid_connect
SOCIALACCOUNT_PROVIDERS='{{ {"openid_connect": {"OAUTH_PKCE_ENABLED": true, "APPS": [{"provider_id": "pocket-id", "name": "Pocket ID", "client_id": yamtrack_oidc_client_id, "secret": yamtrack_oidc_client_secret, "settings": {"server_url": yamtrack_oidc_issuer ~ "/.well-known/openid-configuration"}}]}} | to_json }}'
{% endif %}
