# Variables d'environnement d'Open WebUI (v0.13.x). Référence, à relire à chaque
# montée de version :
#   https://docs.openwebui.com/reference/env-configuration
#   backend/open_webui/config.py et env.py de l'étiquette épinglée.
#
# ENABLE_PERSISTENT_CONFIG=false : sans lui, tout réglage d'administration
# enregistré en base au premier démarrage l'emporte ensuite sur ce fichier
# (une clé de passerelle tournée, par exemple, ne serait jamais reprise). Avec
# lui, ce fichier est la source ; les réglages faits dans Admin > Paramètres
# ne survivent pas à un redémarrage (README du rôle). Les préférences
# des personnes et leurs conversations sont en base, pas concernées.
ENABLE_PERSISTENT_CONFIG=false

TZ=Europe/Paris
WEBUI_URL=https://{{ openwebui_domain }}
WEBUI_SECRET_KEY={{ openwebui_secret_key }}
# Derrière Pangolin (HTTPS) : cookies Secure, origine unique.
WEBUI_SESSION_COOKIE_SECURE=true
CORS_ALLOW_ORIGIN=https://{{ openwebui_domain }}

# --- Comptes -----------------------------------------------------------------
ENABLE_SIGNUP={{ openwebui_enable_signup | bool | lower }}
# Le formulaire par mot de passe reste : accès de secours.
ENABLE_LOGIN_FORM=true
DEFAULT_USER_ROLE={{ openwebui_default_user_role }}
{% if openwebui_oidc_enabled | bool %}
# Pocket ID (defaults/main.yml). Le rappel est fixé ici : Open WebUI sait aussi
# le déduire de la requête, mais Pocket ID n'en accepte qu'un connu.
OAUTH_CLIENT_ID={{ openwebui_oidc_client_id }}
OAUTH_CLIENT_SECRET={{ openwebui_oidc_client_secret }}
OPENID_PROVIDER_URL={{ openwebui_oidc_issuer }}/.well-known/openid-configuration
OPENID_REDIRECT_URI=https://{{ openwebui_domain }}/oauth/oidc/callback
OAUTH_PROVIDER_NAME=Pocket ID
OAUTH_SCOPES=openid email profile
# Pocket ID exige PKCE (client avec pkce_enabled).
OAUTH_CODE_CHALLENGE_METHOD=S256
ENABLE_OAUTH_SIGNUP=true
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true
{% endif %}

# --- IA : passerelle de Pangolin uniquement ----------------------------------
# Pas d'Ollama.
ENABLE_OLLAMA_API=false
{% if openwebui_ai_api_key | length > 0 %}
OPENAI_API_BASE_URL={{ openwebui_ai_base_url }}
OPENAI_API_KEY={{ openwebui_ai_api_key }}
# OPENAI_API_CONFIGS (liste des modèles) : dans compose.yaml, un JSON dans un
# .env dépend du lecteur (compose retire les apostrophes, pas podman).
DEFAULT_MODELS={{ openwebui_default_model }}
TASK_MODEL_EXTERNAL={{ openwebui_task_model }}
{% else %}
# Clé virtuelle « openwebui » absente du state (pas encore appliquée) : aucune
# connexion IA.
ENABLE_OPENAI_API=false
{% endif %}
# Chaque génération automatique est un appel de plus au plafond de tokens :
# seuls les titres restent.
ENABLE_TAGS_GENERATION=false
ENABLE_FOLLOW_UP_GENERATION=false
ENABLE_SEARCH_QUERY_GENERATION=false
ENABLE_RETRIEVAL_QUERY_GENERATION=false

# --- Sans RAG ni calcul local ------------------------------------------------
# Image slim, sans modèle d'embeddings : un fichier joint est lu en entier
# dans le contexte, sans recherche vectorielle.
BYPASS_EMBEDDING_AND_RETRIEVAL=true
{% if openwebui_searxng_enabled | bool %}
# Recherche web par le SearXNG privé du compose (réseau interne). Noms relevés
# dans backend/open_webui/config.py de v0.13.3 (ENABLE_RAG_WEB_SEARCH est
# l'ancien nom). Sans embeddings locaux, les résultats entrent tels quels dans
# le contexte (BYPASS_WEB_SEARCH_EMBEDDING_AND_RETRIEVAL) ; snippets seuls
# tant que BYPASS_WEB_SEARCH_WEB_LOADER vaut true (aucune page téléchargée par
# Open WebUI). La requête est le message tel quel :
# ENABLE_SEARCH_QUERY_GENERATION reste coupé plus haut (un appel IA de moins).
ENABLE_WEB_SEARCH=true
WEB_SEARCH_ENGINE=searxng
SEARXNG_QUERY_URL=http://searxng:8080/search
SEARXNG_LANGUAGE={{ openwebui_searxng_language }}
BYPASS_WEB_SEARCH_EMBEDDING_AND_RETRIEVAL=true
BYPASS_WEB_SEARCH_WEB_LOADER={{ (not (openwebui_web_search_load_pages | bool)) | lower }}
WEB_SEARCH_RESULT_COUNT={{ openwebui_web_search_result_count }}
WEB_SEARCH_CONCURRENT_REQUESTS=1
{% else %}
ENABLE_WEB_SEARCH=false
{% endif %}
ENABLE_IMAGE_GENERATION=false
ENABLE_CODE_EXECUTION=false
ENABLE_CODE_INTERPRETER=false
ENABLE_COMMUNITY_SHARING=false
ENABLE_DIRECT_CONNECTIONS=false

# --- Télémétrie coupée -------------------------------------------------------
ANONYMIZED_TELEMETRY=false
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
# Pas de requête vers GitHub pour chercher une version.
ENABLE_VERSION_UPDATE_CHECK=false
