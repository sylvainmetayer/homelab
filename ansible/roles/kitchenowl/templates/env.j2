JWT_SECRET_KEY={{ kitchenowl_jwt_secret_key }}
JWT_REFRESH_TOKEN_EXPIRES={{ kitchenowl_jwt_refresh_token_expires }}
# Origine admise par CORS et par Socket.IO (cors_allowed_origins) : l'URL
# publique, schéma compris.
FRONT_URL=https://{{ kitchenowl_domain }}
# Un compte par personne, créé à la main (python manage.py) : ni inscription
# libre (la route /api/auth/signup n'est même pas enregistrée), ni onboarding.
# L'onboarding crée un administrateur pour le premier venu tant qu'aucun compte
# n'existe, et /api/* est ouvert sans SSO pour l'appli mobile
# (tofu/pangolin_config/website_kitchenowl.tf) : laissé actif, n'importe qui en
# France ou en Allemagne pourrait le prendre avant nous.
OPEN_REGISTRATION=false
DISABLE_ONBOARDING=true
# Ni métriques Prometheus ni fournisseur d'identité ou de LLM.
COLLECT_METRICS=false
TZ=Europe/Paris
