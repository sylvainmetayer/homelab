HBOX_LOG_LEVEL=info
HBOX_LOG_FORMAT=text
HBOX_WEB_MAX_UPLOAD_SIZE={{ homebox_max_upload_size }}
# ReadTimeout de http.Server : une échéance absolue sur toute la requête,
# corps compris, 10 s par défaut, que Homebox ne lève pour aucun envoi (il ne
# lève que l'échéance d'écriture des téléchargements). Une pièce jointe de
# 25 Mo depuis un téléphone à 10 Mbit/s y passerait 20 s : coupée. Traefik
# (rôle pangolin) laisse 30 min.
HBOX_WEB_READ_TIMEOUT={{ homebox_read_timeout }}
# Ouverte seulement le temps de créer le premier compte (defaults/main.yml).
HBOX_OPTIONS_ALLOW_REGISTRATION={{ homebox_allow_registration | bool | string | lower }}
# Derrière Pangolin (Traefik, puis newt) : le schéma et l'adresse du client
# viennent des en-têtes X-Forwarded-*, que la documentation demande de croire
# derrière un proxy (limite de débit des connexions par client). L'URL
# publique, celle des liens et des QR codes des étiquettes, est fixée ici.
HBOX_OPTIONS_TRUST_PROXY=true
# Le nom d'hôte seul : Homebox y ajoute le schéma (liens) ou « https:// »
# (rappel OIDC, qui devenait https://https:/...), doc de Homebox.
HBOX_OPTIONS_HOSTNAME={{ homebox_domain }}
# Ni statistiques envoyées à l'équipe Homebox, ni appel à GitHub pour les
# nouvelles versions : Renovate s'en charge.
HBOX_OPTIONS_ALLOW_ANALYTICS=false
HBOX_OPTIONS_GITHUB_RELEASE_CHECK=false
HBOX_AUTH_API_KEY_PEPPER={{ homebox_api_key_pepper }}
{% if homebox_oidc_enabled | bool %}
# OIDC par Pocket ID (defaults/main.yml). L'accès par groupe est réglé côté
# Pocket ID (groupes autorisés du client « homebox »), pas ici. Le login local
# reste ouvert : le secours si l'IdP tombe.
HBOX_OIDC_ENABLED=true
HBOX_OIDC_ISSUER_URL={{ homebox_oidc_issuer_url }}
HBOX_OIDC_CLIENT_ID={{ homebox_oidc_client_id }}
HBOX_OIDC_CLIENT_SECRET={{ homebox_oidc_client_secret }}
HBOX_OIDC_SCOPE=openid profile email
HBOX_OIDC_BUTTON_TEXT=Se connecter avec Pocket ID
HBOX_OIDC_AUTO_REDIRECT=false
HBOX_OPTIONS_ALLOW_LOCAL_LOGIN={{ homebox_oidc_allow_local_login | bool | string | lower }}
{% endif %}
TZ=Europe/Paris
