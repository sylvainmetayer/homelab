APP_URL=https://{{ beszel_domain }}
# Les agents ouvrent eux-mêmes une WebSocket vers le hub : le hub n'en
# appelle aucun en SSH.
DISABLE_SSH=true
# L'inspect d'un conteneur montre ses variables d'environnement, donc les
# secrets de chaque compose : ni inspect ni logs dans l'interface.
CONTAINER_DETAILS=false
CHECK_UPDATES=false
# Premier compte (administrateur), au premier démarrage seulement.
USER_EMAIL={{ beszel_admin_email }}
USER_PASSWORD={{ beszel_admin_password }}
