APP_URL=https://{{ beszel_domain }}
# Les agents ouvrent eux-mêmes une WebSocket vers le hub : le hub n'en
# appelle aucun en SSH.
DISABLE_SSH=true
# Fiche d'un conteneur dans l'interface : ses logs (les 200 dernières lignes,
# relayées à la demande par l'agent, jamais stockées dans le hub). Ce réglage
# ouvre aussi l'inspect, que le proxy du socket de chaque agent refuse
# (rôle beszel_agent) : l'agent n'en retire que Config.Env, pas les
# arguments de commande (le --requirepass du redis de nextcloud).
CONTAINER_DETAILS=true
CHECK_UPDATES=false
# Premier compte (administrateur), au premier démarrage seulement.
USER_EMAIL={{ beszel_admin_email }}
USER_PASSWORD={{ beszel_admin_password }}
