APP_URL=https://{{ pocket_id_host }}
ENCRYPTION_KEY={{ pocket_id_enc_key }}
{% if pocket_id_api_key | length > 0 %}
# Clé d'API administrateur de tofu/pangolin_config (clients OIDC, groupes).
STATIC_API_KEY={{ pocket_id_api_key }}
{% endif %}
DB_CONNECTION_STRING=data/pocket-id.db
# Derrière le Traefik de Pangolin : l'IP du client vient de X-Forwarded-For
# (journal d'audit, limites par IP), crue de ce réseau seulement.
TRUST_PROXY={{ pocket_id_trust_proxy }}
# Lieux approximatifs (journal d'audit) : la base City du volume partagé, que
# geoipupdate.service (rôle pangolin) tient à jour. Sans MAXMIND_LICENSE_KEY,
# Pocket ID ne télécharge rien lui-même.
GEOLITE_DB_PATH=/app/geoip/GeoLite2-City.mmdb
# Pas de heartbeat quotidien vers l'équipe Pocket ID.
ANALYTICS_DISABLED=true
# Renovate suit les versions : pas d'appel à GitHub au démarrage.
VERSION_CHECK_DISABLED=true
LOG_LEVEL=info
# Champs structurés dans VictoriaLogs (rôle log_agent).
LOG_JSON=true
TZ=Europe/Paris

# --- Configuration applicative, tenue ici (defaults/main.yml du rôle) ---
UI_CONFIG_DISABLED=true
APP_NAME={{ pocket_id_app_name }}
ACCENT_COLOR={{ pocket_id_accent_color }}
ALLOW_USER_SIGNUPS={{ pocket_id_allow_user_signups }}
{% if pocket_id_smtp_user | length > 0 and pocket_id_smtp_password | length > 0 %}
SMTP_HOST={{ pocket_id_smtp_host }}
SMTP_PORT={{ pocket_id_smtp_port }}
SMTP_TLS={{ pocket_id_smtp_tls }}
# Infomaniak refuse un expéditeur différent du compte authentifié.
SMTP_FROM={{ pocket_id_smtp_user }}
SMTP_USER={{ pocket_id_smtp_user }}
SMTP_PASSWORD={{ pocket_id_smtp_password }}
EMAIL_LOGIN_NOTIFICATION_MODE={{ pocket_id_login_notification_mode }}
EMAIL_ONE_TIME_ACCESS_AS_ADMIN_ENABLED=true
# Jamais de code demandé par l'utilisateur lui-même : la boîte mail ouvrirait tout.
EMAIL_ONE_TIME_ACCESS_AS_UNAUTHENTICATED_ENABLED=false
EMAIL_API_KEY_EXPIRATION_ENABLED=true
EMAIL_VERIFICATION={{ pocket_id_email_verification }}
{% endif %}
