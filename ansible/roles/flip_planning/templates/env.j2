# Environment for the Flip Planning app container.
# Reference: .env.prod.example and README.md § Configuration in the app repo
# (github.com/sylvainmetayer/planning-equipes). Defaults are written out on purpose,
# so this file lists everything the deployment can tune.
DB_URL=jdbc:postgresql://postgres:5432/{{ flip_planning_db_name }}
DB_USER={{ flip_planning_db_user }}
DB_PASSWORD={{ flip_planning_db_password }}
HTTP_PORT=8080
TZ=Europe/Paris
# Heap sized from the container's mem_limit, and the parallel collector — see
# flip_planning_java_options in defaults/main.yml.
JDK_JAVA_OPTIONS={{ flip_planning_java_options }}
# Repair the Flyway history at startup — temporary, see defaults/main.yml.
FLYWAY_REPAIR_AT_START={{ flip_planning_flyway_repair_at_start | lower }}
# Allow the Débogage page to freeze the date and time read by the mode jour J
# screen and the espace animateur — recette only, temporary, see defaults/main.yml.
HORLOGE_SIMULEE_AUTORISEE={{ flip_planning_horloge_simulee_autorisee | lower }}

# Solver budget, operator ceilings and hourly quota — see defaults/main.yml. Written only when
# set: an empty value would override the application's default with nothing.
{% if flip_planning_solver_seconds_limit | string | length > 0 %}
SOLVER_SECONDS_LIMIT={{ flip_planning_solver_seconds_limit }}
{% endif %}
{% if flip_planning_solver_unimproved_seconds_limit | string | length > 0 %}
PLANNING_SOLVER_UNIMPROVED_SECONDS_LIMIT={{ flip_planning_solver_unimproved_seconds_limit }}
{% endif %}
{% if flip_planning_solver_seconds_limit_max | string | length > 0 %}
SOLVER_SECONDS_LIMIT_MAX={{ flip_planning_solver_seconds_limit_max }}
{% endif %}
{% if flip_planning_solver_max_solves_per_hour | string | length > 0 %}
SOLVER_MAX_SOLVES_PER_HOUR={{ flip_planning_solver_max_solves_per_hour }}
{% endif %}
{% if flip_planning_solver_max_queued_jobs | string | length > 0 %}
SOLVER_MAX_QUEUED_JOBS={{ flip_planning_solver_max_queued_jobs }}
{% endif %}
{% if flip_planning_solver_engine | string | length > 0 %}
SOLVER_ENGINE={{ flip_planning_solver_engine }}
{% endif %}

# Outgoing webhooks — see flip_planning_webhooks_enabled in defaults/main.yml.
WEBHOOKS_ENABLED={{ flip_planning_webhooks_enabled | lower }}

# Error tracking (Bugsink, Sentry-compatible). Audience measurement is Cloudflare
# Web Analytics; empty token = off.
SENTRY_DSN={{ flip_planning_sentry_dsn }}
SENTRY_ENVIRONMENT={{ flip_planning_sentry_environment }}
CLOUDFLARE_WEB_ANALYTICS_TOKEN={{ flip_planning_cloudflare_web_analytics_token }}

# MCP server. No extra header is required (PLANNING_MCP_REQUIRED_HEADERS left
# unset), since X-Pangolin is no longer meant to be set by the proxy and
# requiring it would answer 401 to every MCP call — so what guards /mcp is the
# shared key plus the rate ceiling just below.
PLANNING_MCP_API_KEY={{ flip_planning_mcp_api_key }}
PLANNING_MCP_API_KEY_HEADER=X-Api-Key
PLANNING_MCP_PANGOLIN_ACCESS_TOKEN_ID={{ flip_planning_mcp_pangolin_access_token_id | default("") }}
PLANNING_MCP_PANGOLIN_ACCESS_TOKEN={{ flip_planning_mcp_pangolin_access_token | default("") }}
# Requests one source address may make under /mcp per window before the answer
# is 429. EVERY request counts, key or no key — the filter runs ahead of
# authentication, so this bounds trying the key as much as holding it. That is
# also why the address below is not optional here.
#
# PLANNING_MCP_TRUSTED_PROXIES is deliberately left unset: it falls back to
# CONNEXION_PROXYS_FIABLES, and a second list naming the same newt subnet would
# only be one more thing to keep in step.
PLANNING_MCP_MAX_REQUESTS={{ flip_planning_mcp_max_requests }}
PLANNING_MCP_RATE_WINDOW={{ flip_planning_mcp_rate_window }}
# Second guard, on a run of REFUSED keys: the ceiling above bounds the rate, this
# one makes guessing at the key cost time — 120 requests a minute would otherwise
# leave thousands of tries an hour. Past it the address gets 429 for the whole
# duration, the right key included, and the window runs from the LAST failure so
# trying again while blocked gains nothing.
#
# Configuring a client cannot lock it out: a request carrying no key counts for
# nothing, and one that authenticates clears the run. Only a key presented and
# refused counts — which includes the right key without a header that
# PLANNING_MCP_REQUIRED_HEADERS demands, unset here.
PLANNING_MCP_MAX_FAILURES={{ flip_planning_mcp_max_failures }}
PLANNING_MCP_LOCKOUT_DURATION={{ flip_planning_mcp_lockout_duration }}

ADMIN_PASSWORD={{ flip_planning_admin_password }}
QUARKUS_HTTP_AUTH_SESSION_ENCRYPTION_KEY={{ flip_planning_session_encryption_key }}

# Behind Pangolin (Traefik terminates TLS, newt tunnels to the origin):
# PROXY_ADDRESS_FORWARDING keeps the login redirect on https and the session
# cookie Secure.
PROXY_ADDRESS_FORWARDING=true
# Peer address the app sees for a request coming through Pangolin: the newt
# container on the shared bridge. Declared as the network's subnet, since the
# container address itself is reassigned on restart. It is what BOTH
# address-counting guards read — the login lockout and the /mcp ceiling above.
# Without it they count every visitor on newt's single address: five failed
# logins from anyone lock the form for everyone, and on /mcp, which counts each
# request rather than each failure, one anonymous caller holds the legitimate
# client at 429. The role resolves it from the newt network when left empty,
# and fails the deploy rather than shipping the empty value.
CONNEXION_PROXYS_FIABLES={{ flip_planning_trusted_proxies or flip_planning_proxy_subnets[flip_planning_newt_network] }}

# Mail: Mailpit is a sink that delivers nothing (web UI on /mail). The espace
# animateur access codes therefore never leave the host — a real SMTP relay is
# what it would take to open it (MAIL_USERNAME / MAIL_PASSWORD /
# MAIL_START_TLS=REQUIRED on port 587).
MAIL_MOCK=false
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_START_TLS=DISABLED
MAIL_FROM={{ flip_planning_container_prefix }}@localhost
MAIL_ADMIN=admin@localhost

# Night jobs: reminders, acknowledgement chasers, stale exchange alerts. The
# cron is hourly on purpose (each edition sets its own hour on the Paramètres
# screen and must be armed there — nothing leaves otherwise). JOURNAL_RETENTION
# is how long the action history is kept before the night purge.
NOTIFICATIONS_CRON=0 5 * * * ?
NOTIFICATIONS_TIMEZONE=Europe/Paris
JOURNAL_RETENTION=P90D

PUBLIC_URL=https://{{ flip_planning_domain }}

# ---------------------------------------------------------------------------
# Identity provider (OIDC) — see defaults/main.yml and the application's
# docs/oidc.md.
# ---------------------------------------------------------------------------
# Off, nothing but OIDC_ENABLED is written: the break-glass `admin` account
# stays open, as without a provider (ADMIN_LOCAL_SECOURS unset).
#
# The block is CONDITIONAL rather than written out with empty values, against
# the habit of the rest of this file: an empty value is not an unset one.
# `OIDC_AUTH_SERVER_URL=` overrides the application's default with the empty
# string, which its converter reads back as null, and the container dies at
# boot on `Failed to load config value ... quarkus.oidc.auth-server-url` — with
# OIDC switched OFF. So what is not configured is not written.
OIDC_ENABLED={{ flip_planning_oidc_enabled | lower }}
{% if flip_planning_oidc_enabled %}
ADMIN_LOCAL_SECOURS={{ flip_planning_admin_secours_enabled | lower }}
OIDC_AUTH_SERVER_URL={{ flip_planning_oidc_auth_server_url }}
OIDC_CLIENT_ID={{ flip_planning_oidc_client_id }}
OIDC_CLIENT_SECRET={{ flip_planning_oidc_client_secret }}
OIDC_MCP_AUDIENCE={{ flip_planning_oidc_mcp_audience }}
# Traefik terminates TLS at Pangolin: without this the redirect URLs and the
# MCP resource metadata are announced in http, and Keycloak refuses them.
OIDC_FORCE_HTTPS=true
{% endif %}

# Grouped variables (4.0: `key=value;key=value`, a literal `;` written `\;`).
# An empty value is left out: an absent key is the application's default.
{% macro grouped(pairs) -%}
{%- for key, value in pairs.items() if value | string | length > 0 -%}
{{ key }}={{ value | string | replace('\\', '\\\\') | replace(';', '\\;') }}{{ ';' if not loop.last }}
{%- endfor -%}
{%- endmacro %}

# Mentions légales, /mentions-legales. Values live in secrets/ansible.sops.yaml.
# LEGAL_DEMO_INSTANCE lets an instance holding no real data boot with them
# empty — see defaults/main.yml.
LEGAL_DEMO_INSTANCE={{ flip_planning_legal_demo_instance | lower }}
{% if flip_planning_demo_instance | bool %}
# Public demo mode — see flip_planning_demo_instance in defaults/main.yml.
DEMO_INSTANCE=true
{% endif %}
{% if flip_planning_public_instance | bool %}
PUBLIC_INSTANCE=true
{% endif %}
LEGAL_MENTIONS={{ grouped({
  'editeur': flip_planning_legal_editeur,
  'directeur-publication': flip_planning_legal_directeur_publication,
  'hebergeur': flip_planning_legal_hebergeur,
  'contact': flip_planning_legal_contact,
  'responsable-traitement': flip_planning_legal_responsable_traitement,
  'base-legale': flip_planning_legal_base_legale,
  'conservation': flip_planning_legal_conservation,
}) }}

# Branding. The `accent` key of BRANDING_COLORS recolours the application's own stylesheets
# (not the compiled Angular Material palette); the PDF accent red is reused.
# The organisation and that palette are the festival's: an instance with
# flip_planning_branding_client_palette off gets the application's own colours.
# BRANDING_SUPPORT_EMAIL is left at the application default.
#
# Images: each flip_planning_branding_* source is copied to ./assets by the
# role, which the app container mounts on /assets (so the pdf-* keys are file
# paths in the container) and the assets nginx serves under /assets (so
# logo and mascot* are URLs the browser fetches). Same string either way. Empty
# stays empty: the application then shows no logo, no bandeau, no mascot.
{% macro asset(src) -%}
{{ ('/assets/' ~ (src | basename)) if src else '' }}
{%- endmacro %}
BRANDING_PRODUCT_NAME={{ flip_planning_branding_product_name }}
BRANDING_ORGANISATION={{ flip_planning_branding_organisation }}
BRANDING_IMAGES={{ grouped({
  'logo': asset(flip_planning_branding_logo),
  'pdf-logo': asset(flip_planning_branding_pdf_logo),
  'pdf-strip': asset(flip_planning_branding_pdf_strip),
  'mascot': asset(flip_planning_branding_mascot),
  'mascot-icon': asset(flip_planning_branding_mascot_icon),
}) }}
{% if flip_planning_branding_client_palette | bool %}
BRANDING_COLORS=accent=#1dbdc8;pdf-headline=#2b2118;pdf-muted=#927957;pdf-accent=#c81d25;pdf-highlight=#ffd63e;pdf-pill=#faebd0
{% endif %}

BACKUP_DIR=/backup
BACKUP_RETENTION=10
BACKUP_TIMEZONE=Europe/Paris
BACKUP_CRON=0 0 4 * * ?
