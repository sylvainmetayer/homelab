# Environment for the Flip Planning app container.
# Reference: .env.prod.example and README.md § Configuration in the app repo
# (github.com/sylvainmetayer/planning-equipes). Defaults are written out on purpose,
# so this file lists everything the deployment can tune.
DB_URL=jdbc:postgresql://postgres:5432/{{ flip_planning_db_name }}
DB_USER={{ flip_planning_db_user }}
DB_PASSWORD={{ flip_planning_db_password }}
HTTP_PORT=8080
TZ=Europe/Paris
# Repair the Flyway history at startup — temporary, see defaults/main.yml.
FLYWAY_REPAIR_AT_START={{ flip_planning_flyway_repair_at_start | lower }}
# Allow the Débogage page to freeze the date and time read by the mode jour J
# screen and the espace animateur — recette only, temporary, see defaults/main.yml.
HORLOGE_SIMULEE_AUTORISEE={{ flip_planning_horloge_simulee_autorisee | lower }}

# Error tracking (Bugsink, Sentry-compatible). Audience measurement is Cloudflare
# Web Analytics; empty token = off.
SENTRY_DSN=https://e80c2fb7991244f293e4319b7e3d74ba@sylvainmetayer.bugsink.com/1
SENTRY_ENVIRONMENT={{ flip_planning_sentry_environment }}
CLOUDFLARE_WEB_ANALYTICS_TOKEN={{ flip_planning_cloudflare_web_analytics_token }}

# MCP server. No extra header is required (PLANNING_MCP_REQUIRED_HEADERS left
# unset), since X-Pangolin is no longer meant to be set by the proxy and
# requiring it would answer 401 to every MCP call — so what guards /mcp is the
# shared key plus the rate ceiling just below.
PLANNING_MCP_API_KEY={{ flip_planning_mcp_api_key }}
PLANNING_MCP_API_KEY_HEADER=X-Api-Key
PLANNING_MCP_PANGOLIN_ACCESS_TOKEN_ID={{ flip_planning_mcp_pangolin_access_token_id | default("") }}
PLANNING_MCP_PANGOLIN_ACCESS_TOKEN={{ flip_planning_mcp_pangolin_access_token | default("") }}
# Requests one source address may make under /mcp per window before the answer
# is 429. EVERY request counts, key or no key — the filter runs ahead of
# authentication, so this bounds trying the key as much as holding it. That is
# also why the address below is not optional here.
#
# PLANNING_MCP_TRUSTED_PROXIES is deliberately left unset: it falls back to
# CONNEXION_PROXYS_FIABLES, and a second list naming the same newt subnet would
# only be one more thing to keep in step.
PLANNING_MCP_MAX_REQUESTS={{ flip_planning_mcp_max_requests }}
PLANNING_MCP_RATE_WINDOW={{ flip_planning_mcp_rate_window }}

ADMIN_PASSWORD={{ flip_planning_admin_password }}
QUARKUS_HTTP_AUTH_SESSION_ENCRYPTION_KEY={{ flip_planning_session_encryption_key }}

# Behind Pangolin (Traefik terminates TLS, newt tunnels to the origin):
# PROXY_ADDRESS_FORWARDING keeps the login redirect on https and the session
# cookie Secure.
PROXY_ADDRESS_FORWARDING=true
# Peer address the app sees for a request coming through Pangolin: the newt
# container on the shared bridge. Declared as the network's subnet, since the
# container address itself is reassigned on restart. It is what BOTH
# address-counting guards read — the login lockout and the /mcp ceiling above.
# Without it they count every visitor on newt's single address: five failed
# logins from anyone lock the form for everyone, and on /mcp, which counts each
# request rather than each failure, one anonymous caller holds the legitimate
# client at 429. The role resolves it from the newt network when left empty,
# and fails the deploy rather than shipping the empty value.
CONNEXION_PROXYS_FIABLES={{ flip_planning_trusted_proxies }}

# Mail: Mailpit is a sink that delivers nothing (web UI on /mail). The espace
# animateur access codes therefore never leave the host — a real SMTP relay is
# what it would take to open it (MAIL_USERNAME / MAIL_PASSWORD /
# MAIL_START_TLS=REQUIRED on port 587).
MAIL_MOCK=false
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_START_TLS=DISABLED
MAIL_FROM={{ flip_planning_container_prefix }}@localhost
MAIL_ADMIN=admin@localhost

# Night jobs: reminders, acknowledgement chasers, stale exchange alerts. The
# cron is hourly on purpose (each edition sets its own hour on the Paramètres
# screen and must be armed there — nothing leaves otherwise). JOURNAL_RETENTION
# is how long the action history is kept before the night purge.
NOTIFICATIONS_CRON=0 5 * * * ?
NOTIFICATIONS_TIMEZONE=Europe/Paris
JOURNAL_RETENTION=P90D

PUBLIC_URL=https://{{ flip_planning_domain }}

# Mentions légales, /mentions-legales. Values live in secrets.sops.yaml.
LEGAL_EDITEUR={{ flip_planning_legal_editeur }}
LEGAL_DIRECTEUR_PUBLICATION={{ flip_planning_legal_directeur_publication }}
LEGAL_HEBERGEUR={{ flip_planning_legal_hebergeur }}
LEGAL_CONTACT={{ flip_planning_legal_contact }}
LEGAL_RESPONSABLE_TRAITEMENT={{ flip_planning_legal_responsable_traitement }}
LEGAL_BASE_LEGALE={{ flip_planning_legal_base_legale }}
LEGAL_CONSERVATION={{ flip_planning_legal_conservation }}

# Branding. BRANDING_ACCENT_COLOR recolours the application's own stylesheets
# (not the compiled Angular Material palette); the PDF accent red is reused.
# BRANDING_SUPPORT_EMAIL is left at the application default.
#
# Images: each flip_planning_branding_* source is copied to ./assets by the
# role, which the app container mounts on /assets (so BRANDING_PDF_* are file
# paths in the container) and the assets nginx serves under /assets (so
# BRANDING_*_URL are URLs the browser fetches). Same string either way. Empty
# stays empty: the application then shows no logo, no bandeau, no mascot.
{% macro asset(src) -%}
{{ ('/assets/' ~ (src | basename)) if src else '' }}
{%- endmacro %}
BRANDING_PRODUCT_NAME={{ flip_planning_branding_product_name }}
BRANDING_ORGANISATION=Festival Flip — Parthenay
BRANDING_LOGO_URL={{ asset(flip_planning_branding_logo) }}
BRANDING_ACCENT_COLOR=#1dbdc8
BRANDING_PDF_LOGO={{ asset(flip_planning_branding_pdf_logo) }}
BRANDING_PDF_STRIP={{ asset(flip_planning_branding_pdf_strip) }}
BRANDING_PDF_HEADLINE=#2b2118
BRANDING_PDF_MUTED=#927957
BRANDING_PDF_ACCENT=#c81d25
BRANDING_PDF_HIGHLIGHT=#ffd63e
BRANDING_PDF_PILL=#faebd0
BRANDING_MASCOT_URL={{ asset(flip_planning_branding_mascot) }}
BRANDING_MASCOT_ICON_URL={{ asset(flip_planning_branding_mascot_icon) }}

BACKUP_DIR=/backup
BACKUP_RETENTION=10
BACKUP_TIMEZONE=Europe/Paris
BACKUP_CRON=0 0 4 * * ?
