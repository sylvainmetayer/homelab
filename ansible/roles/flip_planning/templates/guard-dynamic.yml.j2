# {{ ansible_managed }}
# Solve quota of {{ flip_planning_service }} — see flip_planning_solve_rate_limit
# in defaults/main.yml.
http:
  routers:
    # The requests that start a solve: every visitor shares one bucket.
    solve:
      rule: >-
        Method(`POST`) &&
        (PathPrefix(`/api/solve/`) || Path(`/api/staffing/verification`))
      entryPoints: [web]
      middlewares: [solve-quota]
      service: app
    # The rest of the two prefixes Pangolin sends here (GET /api/solve/entrees,
    # the staffing reads): untouched.
    passthrough:
      rule: PathPrefix(`/`)
      priority: 1
      entryPoints: [web]
      service: app

  middlewares:
    solve-quota:
      rateLimit:
        average: {{ flip_planning_solve_rate_limit.average }}
        period: {{ flip_planning_solve_rate_limit.period }}
        # The whole hour's allowance can be spent at once; then one more every
        # period / average.
        burst: {{ flip_planning_solve_rate_limit.average }}
        sourceCriterion:
          requestHost: true

  services:
    app:
      loadBalancer:
        servers:
          - url: "http://{{ flip_planning_container_prefix }}:8080"
