[Unit]
Description=Reset Betisier
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory={{ betisier_base_path }}
Environment=PATH=/usr/local/bin:/usr/bin:/bin

# Stop the betisier service
ExecStart=/usr/bin/systemctl --user stop dc@betisier

# Wait for service to stop
ExecStart=/bin/sleep 2

# Docker compose down. `-v` : l'image linuxserver/mariadb déclare
# `VOLUME /config`, donc chaque betisier_db neuf crée un volume anonyme
# (~150 Mo) que `down` seul laissait orphelin (46 en six semaines). Le compose
# n'a que des bind mounts : `-v` ne supprime que ces volumes anonymes.
ExecStart=/usr/bin/docker compose down -v

# Restart the betisier service
ExecStart=/usr/bin/systemctl --user start dc@betisier

# Wait for the database: a fresh container loads the dump (--init-file)
# before it listens, which a fixed sleep did not always cover on this disk.
# Same probe as the compose healthcheck, bounded.
ExecStart=/usr/bin/timeout 180 /bin/sh -c 'until /usr/bin/docker exec betisier_db mariadb-admin ping --host=127.0.0.1 --silent >/dev/null 2>&1; do sleep 2; done'

# Reset the database password
ExecStart=/usr/bin/docker exec betisier_db sh -c 'mariadb -u $$MYSQL_USER -p$$MYSQL_PASSWORD $$MYSQL_DATABASE -e "UPDATE personne set per_pwd = '\''73fd51e2fbe484ff3b05e124f253ebd1'\'';"'

{% if betisier_reset_healthcheck_url %}
# Signal the "Reset Betisier" Uptime Kuma monitor: only reached when every
# ExecStart above succeeded. The URL (the monitor's token) is read from a
# curl config file, never put on the command line (ps, systemctl show, and
# the _CMDLINE journald attaches to every line curl prints).
ExecStartPost=/usr/bin/curl -q -fsS -m 30 --retry 3 -o /dev/null -K {{ betisier_reset_push_config }}

{% endif %}
# Restart policy
Restart=no

[Install]
WantedBy=default.target
