# Variables de Postiz. Référence, à reprendre à chaque montée de version :
#   https://docs.postiz.com/self-host/configuration/reference
MAIN_URL=https://{{ postiz_domain }}
FRONTEND_URL=https://{{ postiz_domain }}
NEXT_PUBLIC_BACKEND_URL=https://{{ postiz_domain }}/api
BACKEND_INTERNAL_URL=http://localhost:3000
JWT_SECRET={{ postiz_jwt_secret }}
DATABASE_URL=postgresql://{{ postiz_db_user }}:{{ postiz_db_password }}@postgres:5432/{{ postiz_db_name }}
REDIS_URL=redis://redis:6379
TEMPORAL_ADDRESS=temporal:7233
IS_GENERAL=true
RUN_CRON=true
API_LIMIT=30

# Inscription locale fermée dès qu'une organisation existe ; le login OIDC
# crée quand même le compte (auth.service.ts, canRegister).
DISABLE_REGISTRATION=true

# Médias sur disque, servis par le nginx de l'image sous /uploads/, que
# Pangolin ouvre sans SSO (tofu/pangolin_config/website_postiz.tf).
STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=/uploads
NEXT_PUBLIC_UPLOAD_DIRECTORY=/uploads

# SMTP : même compte Infomaniak que karakeep et dawarich (invitations d'équipe,
# notifications, mot de passe oublié).
EMAIL_PROVIDER=nodemailer
EMAIL_HOST=mail.infomaniak.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER={{ pangolin_smtp_user }}
EMAIL_PASS={{ pangolin_smtp_pass }}
EMAIL_FROM_ADDRESS={{ pangolin_smtp_user }}
EMAIL_FROM_NAME=Postiz
{% if postiz_oidc_enabled | bool %}

# Pocket ID (defaults/main.yml). Rappel : FRONTEND_URL/settings, sans PKCE
# (oauth.provider.ts).
POSTIZ_GENERIC_OAUTH=true
NEXT_PUBLIC_POSTIZ_OAUTH_DISPLAY_NAME=Pocket ID
NEXT_PUBLIC_POSTIZ_OAUTH_LOGO_URL=https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons@16c42dc580c144246651d322a079e535cb2b69f8/svg/pocket-id.svg
POSTIZ_OAUTH_URL={{ postiz_oidc_issuer }}
POSTIZ_OAUTH_AUTH_URL={{ postiz_oidc_issuer }}/authorize
POSTIZ_OAUTH_TOKEN_URL={{ postiz_oidc_issuer }}/api/oidc/token
POSTIZ_OAUTH_USERINFO_URL={{ postiz_oidc_issuer }}/api/oidc/userinfo
POSTIZ_OAUTH_CLIENT_ID={{ postiz_oidc_client_id }}
POSTIZ_OAUTH_CLIENT_SECRET={{ postiz_oidc_client_secret }}
{% endif %}
{% if postiz_social_env %}

# Réseaux sociaux (postiz_social_env, SOPS).
{% for name, value in postiz_social_env | dictsort %}
{{ name }}={{ value }}
{% endfor %}
{% endif %}
