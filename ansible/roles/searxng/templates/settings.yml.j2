use_default_settings: true

general:
  instance_name: "SearXNG"

search:
  safe_search: 1

server:
  base_url: "https://{{ searxng_domain }}/"
  limiter: false
  image_proxy: true
  # secret_key vient de SEARXNG_SECRET (.env, 0600) : ce fichier-ci est
  # lisible par le conteneur, qui le reprend à son uid au démarrage.
