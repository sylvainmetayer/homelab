NODE_ENV=production
PORT=3000
ENCRYPTION_KEY={{ trek_encryption_key }}
TZ={{ trek_timezone }}
LOG_LEVEL=info
ALLOWED_ORIGINS=https://{{ trek_domain }}
APP_URL=https://{{ trek_domain }}
TRUST_PROXY=1
# Pas de redirection HTTP -> HTTPS dans l'application : Pangolin termine le TLS
# et chaque requête publique arrive avec X-Forwarded-Proto: https, donc la
# redirection ne servait à rien de ce côté. Elle coupait en revanche l'accès
# direct par le réseau Docker `newt` : Nextcloud s'abonne au flux iCal par
# http://trek:3000/api/feed/user/<jeton>.ics, sans passer par Pangolin, et
# FORCE_HTTPS=true le renvoyait vers l'URL publique, derrière le SSO.
# HSTS et le cookie de session `Secure` restent actifs : TREK les dérive de
# NODE_ENV=production, pas de cette variable.
FORCE_HTTPS=false
