NODE_ENV=production
PORT=3000
ENCRYPTION_KEY={{ trek_encryption_key }}
TZ={{ trek_timezone }}
LOG_LEVEL=info
ALLOWED_ORIGINS=https://{{ trek_domain }}
APP_URL=https://{{ trek_domain }}
TRUST_PROXY=1
# Pas de redirection HTTP -> HTTPS dans l'application : Pangolin termine le TLS
# et chaque requête publique arrive avec X-Forwarded-Proto: https, donc la
# redirection ne servait à rien de ce côté. Elle coupait en revanche l'accès
# direct par le réseau Docker `newt` : Nextcloud s'abonne au flux iCal par
# http://trek:3000/api/feed/user/<jeton>.ics, sans passer par Pangolin, et
# FORCE_HTTPS=true le renvoyait vers l'URL publique, derrière le SSO.
# HSTS et le cookie de session `Secure` restent actifs : TREK les dérive de
# NODE_ENV=production, pas de cette variable.
FORCE_HTTPS=false
{% if trek_oidc_enabled | bool %}
# OIDC par Pocket ID (defaults/main.yml). L'accès par groupe (trek,
# trek-admin) est réglé côté Pocket ID ; le login local reste ouvert.
OIDC_ISSUER={{ trek_oidc_issuer }}
OIDC_CLIENT_ID={{ trek_oidc_client_id }}
OIDC_CLIENT_SECRET={{ trek_oidc_client_secret }}
OIDC_DISPLAY_NAME=Pocket ID
OIDC_SCOPE=openid email profile groups
OIDC_ADMIN_CLAIM=groups
OIDC_ADMIN_VALUE={{ trek_oidc_admin_value }}
# Nom d'utilisateur d'un compte créé par SSO : preferred_username de Pocket ID
# plutôt que le nom complet (lu à la création du compte seulement).
OIDC_USERNAME_CLAIM=preferred_username
OIDC_ONLY=false
{% endif %}
