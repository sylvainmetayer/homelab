# Variables d'OpenPost. Référence, à reprendre à chaque montée de version :
#   https://openpo.st/docs/self-hosting/configuration
#   https://github.com/getopenpost/openpost/blob/main/.env.example
OPENPOST_APP_URL=https://{{ openpost_domain }}
OPENPOST_PUBLIC_URL=https://{{ openpost_domain }}
# Servi par l'appli sous /media/, que Pangolin ouvre sans SSO
# (tofu/pangolin_config/website_openpost.tf) : Instagram, Threads, Facebook et
# TikTok viennent y chercher les fichiers.
OPENPOST_MEDIA_URL=https://{{ openpost_domain }}/media
OPENPOST_TRUSTED_PROXY_CIDRS={{ openpost_trusted_proxy_cidrs }}
OPENPOST_JWT_SECRET={{ openpost_jwt_secret }}
OPENPOST_ENCRYPTION_KEY={{ openpost_encryption_key }}
OPENPOST_DISABLE_REGISTRATIONS={{ openpost_disable_registrations | lower }}
# Les versions arrivent par Renovate.
OPENPOST_UPDATE_CHECK_ENABLED=false
OPENPOST_TELEMETRY_ENABLED=false
# Allumé par défaut (config.go, v7.39.0) : chaque erreur part vers
# app.openpo.st avec un identifiant d'installation.
OPENPOST_DIAGNOSTICS_ENABLED=false

# SMTP : même compte Infomaniak que karakeep et dawarich (mot de passe oublié,
# invitations, notifications).
OPENPOST_EMAIL_PROVIDER=smtp
OPENPOST_EMAIL_FROM={{ pangolin_smtp_user }}
OPENPOST_SMTP_HOST=mail.infomaniak.com
OPENPOST_SMTP_PORT=587
OPENPOST_SMTP_TLS_MODE=starttls
OPENPOST_SMTP_USERNAME={{ pangolin_smtp_user }}
OPENPOST_SMTP_PASSWORD={{ pangolin_smtp_pass }}
{% if openpost_stock_media_enabled | bool %}

# Banques d'images du sélecteur de médias (README, « Banques d'images ») :
# éteintes tant qu'aucune clé n'est dans SOPS.
OPENPOST_STOCK_MEDIA_ENABLED=true
OPENPOST_UNSPLASH_ACCESS_KEY={{ openpost_unsplash_access_key | default('') }}
OPENPOST_PIXABAY_API_KEY={{ openpost_pixabay_api_key | default('') }}
{% endif %}
{% if openpost_oidc_enabled | bool %}

# Pocket ID (defaults/main.yml) : fournisseur d'instance, id fixe « instance »,
# donc rappel /api/v1/auth/oidc/instance/callback. PKCE S256, e-mail vérifié
# exigé (identity/service.go). Le mot de passe local reste.
OPENPOST_OIDC_ISSUER={{ openpost_oidc_issuer }}
OPENPOST_OIDC_CLIENT_ID={{ openpost_oidc_client_id }}
OPENPOST_OIDC_CLIENT_SECRET={{ openpost_oidc_client_secret }}
OPENPOST_OIDC_NAME=Pocket ID
OPENPOST_OIDC_JIT_ENABLED=true
{% endif %}
