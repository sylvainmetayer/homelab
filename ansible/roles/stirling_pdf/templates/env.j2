PUID={{ ansible_facts['user_uid'] }}
PGID={{ ansible_facts['user_gid'] }}
# Pas de compte Stirling-PDF : le SSO de Pangolin est la seule porte.
SECURITY_ENABLELOGIN=false
# Télémétrie coupée (PostHog, pixel Scarf) et pas de question au premier
# lancement ; ni vérification de mise à jour (GitHub) ni diapositive
# d'installation de l'appli de bureau.
SYSTEM_ENABLEANALYTICS=false
SYSTEM_ENABLEPOSTHOG=false
SYSTEM_ENABLESCARF=false
SYSTEM_SHOWUPDATE=false
SYSTEM_ENABLEDESKTOPINSTALLSLIDE=false
SYSTEM_GOOGLEVISIBILITY=false
SYSTEM_DEFAULTLOCALE=fr-FR
# Vide, CORS admettrait toutes les origines, avec les cookies.
SYSTEM_CORSALLOWEDORIGINS=https://{{ stirling_pdf_domain }}
# Liens donnés au navigateur (QR codes de l'envoi depuis un téléphone).
SYSTEM_FRONTENDURL=https://{{ stirling_pdf_domain }}
TZ={{ stirling_pdf_timezone }}
# L'image lance Java avec -XX:+HeapDumpOnOutOfMemoryError et
# HeapDumpPath=/configs/heap_dumps : chaque OutOfMemoryError écrirait un dump
# de la taille du tas (~1,3 Gio) dans configs/, sur le disque rotatif de la
# VM, jamais nettoyé. Ajoutées après les options de l'image
# (JAVA_TOOL_OPTIONS), ces options l'emportent ; ExitOnOutOfMemoryError reste,
# et dc@ redémarre le conteneur.
JAVA_CUSTOM_OPTS=-XX:-HeapDumpOnOutOfMemoryError
