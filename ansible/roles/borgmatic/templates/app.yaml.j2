# Configuration borgmatic de {{ borgmatic_app_title }}, générée par le rôle
# borgmatic (tasks/app.yml) : toute modification ici est écrasée au prochain
# déploiement. Référence : https://torsion.org/borgmatic/reference/configuration/
#
# Dépôt : Storage Box Hetzner en SSH (clé /root/.ssh/backup_storage_box_key).

{% set sqlite_staging = borgmatic_sqlite_staging_dir ~ '/' ~ borgmatic_app_name %}
# Fichiers et dossiers sauvegardés tels quels.
source_directories:
{% for source in borgmatic_app_source_directories %}
    - {{ source | to_json }}
{% endfor %}
{% if borgmatic_app_sqlite_paths | length > 0 %}
    # Copies cohérentes des bases SQLite, faites par le hook before plus bas.
    - {{ sqlite_staging | to_json }}
{% endif %}
{% if borgmatic_app_postgresql_databases | length > 0 %}

# pg_dump tourne dans le conteneur de la base : client et serveur toujours de
# même version. « --env PGPASSWORD » sans valeur transmet au conteneur le mot
# de passe que borgmatic pose dans l'environnement de l'hôte (docker exec
# n'hérite pas de cet environnement).
postgresql_databases:
{% for database in borgmatic_app_postgresql_databases %}
    - container: {{ database.container | to_json }}
      port: {{ database.port | default(5432) }}
      name: {{ database.name | to_json }}
      username: {{ database.username | to_json }}
      password: {{ database.password | to_json }}
      pg_dump_command: {{ ('docker exec --env PGPASSWORD ' ~ database.container ~ ' pg_dump') | to_json }}
{% endfor %}
{% endif %}
{% if borgmatic_app_mysql_databases | length > 0 %}

# Le client de dump tourne dans le conteneur de la base, pour la même raison,
# à travers {{ borgmatic_docker_dump_bin }} : borgmatic 2.1 lui passe un
# --result-file de l'hôte, introuvable dans le conteneur ; le script le
# retire et écrit lui-même la sortie du client dans ce fichier. Le mot de
# passe passe par l'environnement (password_transport), que le script
# transmet au conteneur (« --env MYSQL_PWD »).
mysql_databases:
{% for database in borgmatic_app_mysql_databases %}
    - container: {{ database.container | to_json }}
      port: {{ database.port | default(3306) }}
      name: {{ database.name | to_json }}
      username: {{ database.username | to_json }}
      password: {{ database.password | to_json }}
      password_transport: environment
      mysql_dump_command: {{ (borgmatic_docker_dump_bin ~ ' ' ~ database.container ~ ' ' ~ (database.dump_command | default('mysqldump'))) | to_json }}
{% endfor %}
{% endif %}

# Motifs exclus (style fm: de borg, cf. borgmatic_exclude_patterns). La copie
# vivante des bases SQLite en fait partie : seule leur copie cohérente du
# dossier de staging est archivée.
exclude_patterns:
{% for pattern in borgmatic_exclude_patterns + borgmatic_app_exclude_patterns %}
    - {{ pattern | to_json }}
{% endfor %}
{% for path in borgmatic_app_sqlite_paths %}
{% for suffix in ['', '-wal', '-shm', '-journal'] %}
    - {{ (path ~ suffix) | to_json }}
{% endfor %}
{% endfor %}

local_path: /root/.local/bin/borg

repositories:
    - path: {{ borgmatic_app_target | to_json }}
      label: {{ borgmatic_app_label | to_json }}

ssh_command: ssh -i /root/.ssh/backup_storage_box_key -p 23

encryption_passphrase: {{ borgmatic_app_passphrase | to_json }}

compression: zstd,10

# Rétention : clés de premier niveau (pas sous « retention: »).
keep_daily: 7
keep_weekly: 4
keep_monthly: 6
keep_yearly: 1

# Vérifications : premier niveau aussi (pas sous « consistency: »).
checks:
    - name: repository
      frequency: 2 weeks
    - name: archives
      frequency: 1 month

archive_name_format: '{{ borgmatic_app_archive_prefix }}-{now:%Y-%m-%dT%H:%M:%S}'
{% if borgmatic_app_extra_options | length > 0 %}

{{ borgmatic_app_extra_options | to_nice_yaml(indent=4) | trim }}
{% endif %}

commands:
    - before: action
      when:
          - create
      run:
          - echo "Starting {{ borgmatic_app_title }} backup at $(date)"
{% if borgmatic_app_sqlite_paths | length > 0 %}
          # Bases SQLite trouvées au déploiement : copie par l'API de
          # sauvegarde en ligne (« .backup »), cohérente même application
          # démarrée. Le verrou ne dure que la copie locale, pas l'envoi vers
          # la Storage Box (cf. borgmatic_app_sqlite_databases). « .timeout »
          # attend une écriture en cours au lieu d'échouer sur « database is
          # locked » ; -bail fait échouer la sauvegarde si la copie échoue.
          - {{ ('find ' ~ (sqlite_staging | quote) ~ ' -mindepth 1 -delete') | to_json }}
{% for path in borgmatic_app_sqlite_paths %}
          - {{ ('sqlite3 -bail -cmd ' ~ ('.timeout 60000' | quote) ~ ' ' ~ (path | quote) ~ ' ' ~ ('.backup ' ~ ((sqlite_staging ~ '/' ~ (path | regex_replace('^/', '') | replace('/', '_'))) | quote)) | quote) | to_json }}
{% endfor %}
{% endif %}
{% for command in borgmatic_app_before_commands %}
          - {{ command | to_json }}
{% endfor %}
    - after: action
      when:
          - create
      run:
          - echo "{{ borgmatic_app_title }} backup completed at $(date)"
{% if borgmatic_app_sqlite_paths | length > 0 %}
          - {{ ('find ' ~ (sqlite_staging | quote) ~ ' -mindepth 1 -delete') | to_json }}
{% endif %}
{% for command in borgmatic_app_after_commands %}
          - {{ command | to_json }}
{% endfor %}
{% if borgmatic_app_healthcheck_url %}

# https://torsion.org/borgmatic/reference/configuration/monitoring/uptime-kuma/
uptime_kuma:
    push_url: {{ borgmatic_app_healthcheck_url | to_json }}
    states:
        - start
        - finish
        - fail
{% endif %}
