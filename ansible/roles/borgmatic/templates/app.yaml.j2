# Configuration borgmatic de {{ borgmatic_app_title }}, générée par le rôle
# borgmatic (tasks/app.yml) : toute modification ici est écrasée au prochain
# déploiement. Référence : https://torsion.org/borgmatic/reference/configuration/
#
# Dépôt : sous-compte Storage Box de l'hôte, en SSH (clé {{ backup_storage_box_ssh_key_path }}).

{% set sqlite_staging = borgmatic_sqlite_staging_dir ~ '/' ~ borgmatic_app_name %}
# Fichiers et dossiers sauvegardés tels quels.
source_directories:
{% for source in borgmatic_app_source_directories %}
    - {{ source | to_json }}
{% endfor %}
{% if borgmatic_app_sqlite_paths | length > 0 %}
    # Copies cohérentes des bases SQLite, faites par le hook before plus bas.
    - {{ sqlite_staging | to_json }}
{% endif %}
{% if borgmatic_app_postgresql_databases | length > 0 %}

# pg_dump tourne dans le conteneur de la base : client et serveur toujours de
# même version. « --env PGPASSWORD » sans valeur transmet au conteneur le mot
# de passe que borgmatic pose dans l'environnement de l'hôte (docker exec
# n'hérite pas de cet environnement).
postgresql_databases:
{% for database in borgmatic_app_postgresql_databases %}
    - container: {{ database.container | to_json }}
      port: {{ database.port | default(5432) }}
      name: {{ database.name | to_json }}
      username: {{ database.username | to_json }}
      password: {{ database.password | to_json }}
      pg_dump_command: {{ ('docker exec --env PGPASSWORD ' ~ database.container ~ ' pg_dump') | to_json }}
{% endfor %}
{% endif %}
{% if borgmatic_app_mysql_databases | length > 0 %}

# Le client de dump tourne dans le conteneur de la base, pour la même raison,
# à travers {{ borgmatic_docker_dump_bin }} : borgmatic 2.1 lui passe un
# --result-file de l'hôte, introuvable dans le conteneur ; le script le
# retire et écrit lui-même la sortie du client dans ce fichier. Le mot de
# passe arrive au script par l'environnement (password_transport), qui le
# remet au client dans un fichier d'options lu sur son entrée standard : par
# MYSQL_PWD, le client MariaDB ne vérifierait pas le certificat TLS du
# serveur (« insecure passwordless login »).
mysql_databases:
{% for database in borgmatic_app_mysql_databases %}
    - container: {{ database.container | to_json }}
      port: {{ database.port | default(3306) }}
      name: {{ database.name | to_json }}
      username: {{ database.username | to_json }}
      password: {{ database.password | to_json }}
      password_transport: environment
      mysql_dump_command: {{ (borgmatic_docker_dump_bin ~ ' ' ~ database.container ~ ' ' ~ (database.dump_command | default('mariadb-dump'))) | to_json }}
{% endfor %}
{% endif %}

# Motifs exclus (style fm: de borg, cf. borgmatic_exclude_patterns). La copie
# vivante des bases SQLite en fait partie : seule leur copie cohérente du
# dossier de staging est archivée.
exclude_patterns:
{% for pattern in borgmatic_exclude_patterns + borgmatic_app_exclude_patterns %}
    - {{ pattern | to_json }}
{% endfor %}
{% for path in borgmatic_app_sqlite_paths %}
{% for suffix in ['', '-wal', '-shm', '-journal'] %}
    - {{ (path ~ suffix) | to_json }}
{% endfor %}
{% endfor %}

local_path: {{ borgmatic_borg_bin }}

repositories:
    - path: {{ borgmatic_app_target | to_json }}
      label: {{ borgmatic_app_label | to_json }}

ssh_command: ssh -i {{ backup_storage_box_ssh_key_path }} -p 23

encryption_passphrase: {{ borgmatic_app_passphrase | to_json }}

compression: zstd,10

# Rétention : clés de premier niveau (pas sous « retention: »).
keep_daily: 7
keep_weekly: 4
keep_monthly: 6
keep_yearly: 1

# Vérifications : premier niveau aussi (pas sous « consistency: »).
checks:
    - name: repository
      frequency: 2 weeks
    - name: archives
      frequency: 1 month

archive_name_format: '{{ borgmatic_app_archive_prefix }}-{now:%Y-%m-%dT%H:%M:%S}'
{% if borgmatic_app_extra_options | length > 0 %}

{{ borgmatic_app_extra_options | to_nice_yaml(indent=4) | trim }}
{% endif %}

commands:
    - before: action
      when:
          - create
      run:
          - echo "Starting {{ borgmatic_app_title }} backup at $(date)"
{% if borgmatic_app_sqlite_paths | length > 0 %}
          # Bases SQLite trouvées au déploiement : copie cohérente même
          # application démarrée, dans le dossier de staging. Le verrou ne
          # dure que la copie locale, pas l'envoi vers la Storage Box (cf.
          # borgmatic_app_sqlite_databases). Base en WAL : « VACUUM INTO »,
          # une seule transaction de lecture, qui ne bloque pas les écritures
          # de l'application. Sinon « .backup », qui lâche le verrou entre
          # deux paquets de pages mais recommence au début à chaque écriture
          # d'un autre processus : sur une base écrite en continu il ne finit
          # jamais (Pangolin, 28/10/2026), d'où le WAL pour celles-là.
          # « .timeout » attend une écriture en cours au lieu d'échouer sur
          # « database is locked » ; -bail fait échouer la sauvegarde si la
          # copie échoue. -noheader -list sur la sonde du mode : un ~/.sqliterc
          # de root (.headers on, .mode line) ferait sinon rater « = wal » et
          # renverrait une base en WAL vers « .backup ».
          - {{ ('find ' ~ (sqlite_staging | quote) ~ ' -mindepth 1 -delete') | to_json }}
{% for path in borgmatic_app_sqlite_paths %}
{% set sqlite_copy = sqlite_staging ~ '/' ~ (path | regex_replace('^/', '') | replace('/', '_')) %}
{% set sqlite_args = '-cmd ' ~ ('.timeout 60000' | quote) ~ ' ' ~ (path | quote) %}
{% set sqlite_cli = 'sqlite3 -bail ' ~ sqlite_args %}
          - {{ ('if [ "$(sqlite3 -bail -noheader -list ' ~ sqlite_args ~ ' ' ~ ('pragma journal_mode' | quote) ~ ')" = wal ]; then '
                ~ sqlite_cli ~ ' ' ~ (("VACUUM INTO '" ~ (sqlite_copy | replace("'", "''")) ~ "'") | quote)
                ~ '; else ' ~ sqlite_cli ~ ' ' ~ (('.backup ' ~ (sqlite_copy | quote)) | quote) ~ '; fi') | to_json }}
{% endfor %}
{% endif %}
{% for command in borgmatic_app_before_commands %}
          - {{ command | to_json }}
{% endfor %}
    - after: action
      when:
          - create
      run:
          - echo "{{ borgmatic_app_title }} backup completed at $(date)"
{% if borgmatic_app_sqlite_paths | length > 0 %}
          - {{ ('find ' ~ (sqlite_staging | quote) ~ ' -mindepth 1 -delete') | to_json }}
{% endif %}
{% for command in borgmatic_app_after_commands %}
          - {{ command | to_json }}
{% endfor %}
{% if borgmatic_app_healthcheck_url %}
{% set push = (uptime_push_bin | quote) ~ ' --agent borgmatic ' ~ (borgmatic_app_push_config | quote) %}
    # Moniteur push Uptime Kuma, aux mêmes moments que le hook uptime_kuma de
    # borgmatic : début, fin ou échec de la configuration, pour create,
    # prune, compact ou check. Pas ce hook-là : il écrit l'URL push, jeton
    # compris, au journal à chaque run (« Pushing Uptime Kuma push_url … »,
    # niveau INFO), d'où elle partait vers VictoriaLogs. Le push passe par
    # uptime-push (rôle uptime_push, 21 s au pire par push) : l'URL est dans
    # un fichier de configuration curl (0600 root, tasks/app.yml), jamais sur
    # la ligne de commande. uptime-push sort en 0 sur un push raté ;
    # « || true » couvre en plus un script absent : comme avec le hook natif,
    # un push raté n'avertit qu'au journal, sans faire échouer la sauvegarde.
    - before: configuration
      when: {{ borgmatic_push_actions | to_json }}
      run:
          - {{ (push ~ ' up start || true') | to_json }}
    - after: configuration
      when: {{ borgmatic_push_actions | to_json }}
      states:
          - finish
      run:
          - {{ (push ~ ' up finish || true') | to_json }}
    - after: configuration
      when: {{ borgmatic_push_actions | to_json }}
      states:
          - fail
      run:
          - {{ (push ~ ' down fail || true') | to_json }}
{% endif %}
