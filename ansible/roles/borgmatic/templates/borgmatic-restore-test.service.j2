[Unit]
Description=borgmatic restore test
Wants=network-online.target
After=network-online.target borgmatic.service

[Service]
Type=oneshot
User=root
Group=root
# Settings come from /etc/borgmatic-restore-test.json, written by Ansible.
ExecStart=/usr/bin/python3 /usr/local/bin/borgmatic-restore-test
# Extractions land in /var/lib/borgmatic-restore-test, root-only.
StateDirectory=borgmatic-restore-test
StateDirectoryMode=0700
# Extraction is I/O heavy and nothing waits on it.
Nice=10
IOSchedulingClass=idle
