KEY={{ beszel_agent_hub_key | trim }}
TOKEN={{ beszel_agent_token }}
HUB_URL={{ beszel_agent_hub_url }}
{% if beszel_agent_hub_headers | length > 0 %}
HUB_HEADERS={{ beszel_agent_hub_headers }}
{% endif %}
# Aucun port en écoute : la connexion part de l'agent.
DISABLE_SSH=true
# Pas de requêtes aux registres depuis chaque hôte : les images sont épinglées
# par digest (que Beszel ignore de toute façon) et Renovate les suit.
DOCKER_IMAGE_CHECK=false
{% if beszel_agent_mode == 'binary' %}
DATA_DIR=/var/lib/beszel-agent
# Pas de Docker ici.
DOCKER_HOST=
SERVICE_PATTERNS={{ beszel_agent_service_patterns }}
{% else %}
DOCKER_HOST=unix:///run/socket-proxy/docker.sock
# Pas d'accès au bus système depuis le conteneur.
SKIP_SYSTEMD=true
{% endif %}
{% if beszel_agent_smart_devices | length > 0 %}
SMART_DEVICES={% for device in beszel_agent_smart_devices %}{{ device.path }}{% if device.type | default('') %}:{{ device.type }}{% endif %}{{ '' if loop.last else ',' }}{% endfor %}

{% else %}
# Vide : S.M.A.R.T. coupé.
SMART_DEVICES=
{% endif %}
