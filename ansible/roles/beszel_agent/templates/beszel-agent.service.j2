# Agent Beszel (rôle beszel_agent, mode binary). Jeton et clé dans
# {{ beszel_agent_config_dir }}/env (0600), pas sur la ligne de commande : ps
# les montrerait à tout le conteneur.
[Unit]
Description=Beszel agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile={{ beszel_agent_config_dir }}/env
ExecStart={{ beszel_agent_binary_dir }}/{{ beszel_agent_binary_version }}/beszel-agent
Restart=always
RestartSec=10
# Compte éphémère sans privilège : l'agent lit /proc, /sys et le bus systemd,
# n'écrit que son empreinte (StateDirectory).
DynamicUser=yes
StateDirectory=beszel-agent
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
{% if beszel_agent_smart_devices | length > 0 %}
# S.M.A.R.T. (beszel_agent_smart_devices) : l'agent lance smartctl, qui ouvre
# le disque (groupe disk) et lui envoie ses commandes ATA par SG_IO, réservé à
# CAP_SYS_RAWIO. Ambiante : elle survit à l'exec de smartctl, NoNewPrivileges
# ne bloque que les gains par setuid ou capacités de fichier.
SupplementaryGroups=disk
AmbientCapabilities=CAP_SYS_RAWIO
CapabilityBoundingSet=CAP_SYS_RAWIO
{% else %}
CapabilityBoundingSet=
{% endif %}

[Install]
WantedBy=multi-user.target
