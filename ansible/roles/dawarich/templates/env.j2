RAILS_ENV=production
REDIS_URL=redis://dawarich-redis:6379

DATABASE_HOST=dawarich-db
DATABASE_PORT=5432
DATABASE_NAME={{ dawarich_db_name }}
DATABASE_USERNAME={{ dawarich_db_user }}
DATABASE_PASSWORD={{ dawarich_db_password }}

JWT_SECRET_KEY={{ dawarich_jwt_secret_key }}
AUTH_JWT_SECRET_KEY={{ dawarich_auth_jwt_secret_key }}
SECRET_KEY_BASE={{ dawarich_secret_key_base }}

APPLICATION_HOSTS={{ dawarich_domain }}
APPLICATION_PROTOCOL=https
TIME_ZONE={{ dawarich_timezone }}
PROMETHEUS_EXPORTER_ENABLED=false
RAILS_LOG_TO_STDOUT=true
SELF_HOSTED=true
STORE_GEODATA=true
WEB_CONCURRENCY=1
BACKGROUND_PROCESSING_CONCURRENCY=3
