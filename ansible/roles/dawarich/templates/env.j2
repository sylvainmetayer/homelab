RAILS_ENV=production
REDIS_URL=redis://dawarich-redis:6379

DATABASE_HOST=dawarich-db
DATABASE_PORT=5432
DATABASE_NAME={{ dawarich_db_name }}
DATABASE_USERNAME={{ dawarich_db_user }}
DATABASE_PASSWORD={{ dawarich_db_password }}

JWT_SECRET_KEY={{ dawarich_jwt_secret_key }}
AUTH_JWT_SECRET_KEY={{ dawarich_auth_jwt_secret_key }}
SECRET_KEY_BASE={{ dawarich_secret_key_base }}

APPLICATION_HOSTS={{ dawarich_domain }}
APPLICATION_PROTOCOL=http
TIME_ZONE={{ dawarich_timezone }}
PROMETHEUS_EXPORTER_ENABLED=false
RAILS_LOG_TO_STDOUT=true
SELF_HOSTED=true
STORE_GEODATA=true
# Jobs dans le processus web (1.17.0). WEB_CONCURRENCY doit rester à 0 :
# chaque processus web de plus lancerait ses propres threads de jobs.
SIDEKIQ_EMBEDDED=true
WEB_CONCURRENCY=0
BACKGROUND_PROCESSING_CONCURRENCY=2

# ─── Reverse geocoding (Chibigeo) ──────────────────────────────────────────────
# https://dawarich.app/docs/self-hosting/configuration/reverse-geocoding/
PHOTON_API_HOST=app.chibigeo.com/v1/photon
PHOTON_API_KEY={{ dawarich_chibigeo_api_key }}
PHOTON_API_USE_HTTPS=true

# ─── SMTP email ───────────────────────────────────────────────────────────────
# Password resets, digests, and family invites, sent by the embedded Sidekiq
# of dawarich-app.
DOMAIN={{ dawarich_domain }}
SMTP_SERVER=mail.infomaniak.com
SMTP_PORT=587
SMTP_USERNAME={{ pangolin_smtp_user }}
SMTP_PASSWORD={{ pangolin_smtp_pass }}
SMTP_FROM={{ pangolin_smtp_user }}
SMTP_STARTTLS=true
