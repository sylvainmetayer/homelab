# {{ ansible_managed }}
# Persistent rattrape un passage manqué ; le curseur du script couvre le trou.
[Unit]
Description=CI SSH key audit, every 10 minutes

[Timer]
OnCalendar={{ ci_key_audit_schedule }}
OnActiveSec={{ ci_key_audit_first_run_delay }}
RandomizedDelaySec=30s
Persistent=true

[Install]
WantedBy=timers.target
