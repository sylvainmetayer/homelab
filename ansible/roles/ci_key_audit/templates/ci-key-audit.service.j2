# {{ ansible_managed }}
# Connexions de la clé SSH de la CI comparées aux runs GitHub (rôle ci_key_audit).
# Secrets dans l'EnvironmentFile, 0600 root, jamais sur la ligne de commande :
# systemctl show et ps la montreraient.
[Unit]
Description=Audit of the CI SSH key logins against the GitHub runs
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile={{ ci_key_audit_config_dir }}/secrets.env
# Compte éphémère ; n'écrit que son état (StateDirectory).
DynamicUser=yes
StateDirectory=ci-key-audit
ExecStart=/usr/bin/python3 -I {{ ci_key_audit_script }}
# Réseau en panne : quelques requêtes de 30 s, réessayées. Borné, pour que
# l'unité ne reste pas « activating ».
TimeoutStartSec=5min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
CapabilityBoundingSet=
# AF_UNIX : la résolution DNS par systemd-resolved (nss).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Pic mesuré sous Molecule : 14 Mio, 2x comme la doctrine, plus de la place pour
# une fenêtre longue (10 000 lignes au plus).
MemoryMax=64M
