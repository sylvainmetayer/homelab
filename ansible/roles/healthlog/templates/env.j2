NODE_ENV=production
TZ=Europe/Paris

# Base : réseau interne `healthlog`. connection_limit explicite comme l'amont
# (le défaut de Prisma, cpu*2+1, affame le processus web+worker).
DATABASE_URL=postgresql://{{ healthlog_db_user }}:{{ healthlog_db_password }}@healthlog-db:5432/{{ healthlog_db_name }}?schema=public&connection_limit=20&pool_timeout=20

# URL publique : redirections OAuth (Withings : /api/withings/callback),
# liens des notifications, jobs de fond.
NEXT_PUBLIC_APP_URL=https://{{ healthlog_domain }}
APP_URL=https://{{ healthlog_domain }}

# Chiffrement au repos et jetons : dérivés de backup_passphrase
# (defaults/main.yml, README « Clé de chiffrement »).
ENCRYPTION_KEY={{ healthlog_encryption_key }}
API_TOKEN_HMAC_KEY={{ healthlog_api_token_hmac_key }}
WITHINGS_WEBHOOK_SECRET={{ healthlog_withings_webhook_secret }}

# Un seul proxy HTTP devant (Traefik de Pangolin ; Newt est un tunnel, il
# n'ajoute pas d'en-tête) : l'adresse du client est la dernière de
# X-Forwarded-For. TRUSTED_PROXY_CIDRS reste vide (toute adresse privée) :
# aucun port publié, seul le réseau newt atteint l'appli, mais tout conteneur
# de ce réseau partagé pourrait forger X-Forwarded-For (limite de débit par
# IP, journal d'audit). Le sous-réseau de newt ne restreindrait rien de plus,
# et l'IP du conteneur newt n'est pas fixe : risque accepté.
TRUST_PROXY_HOPS=1

# Données de santé : aucun appel sortant qui ne serve pas l'appli. Pas de
# géolocalisation des IP de connexion chez ipwho.is, pas de vérification de
# version sur GitHub (Renovate suit les versions).
IP_GEO_LOOKUP_DISABLED=1
UPDATE_CHECK_DISABLED=1
HEALTHLOG_PLATFORM=compose

# Web et worker dans le même processus (défaut de l'amont, un seul hôte).
HEALTHLOG_PROCESS_TYPE=all

# Sauvegarde : borgmatic dumpe la base chaque nuit, le dump nocturne de
# HealthLog est coupé ; celui d'avant migration reste (volume `backups`).
# Pas de copie S3 : BACKUP_S3_* restent vides.
DB_BACKUP_ENABLED=false
DB_BACKUP_BEFORE_MIGRATE=true

# Courriel (réinitialisation du mot de passe, notifications choisies par
# l'utilisateur) : même boîte Infomaniak que Pangolin et Dawarich, STARTTLS
# sur 587.
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER={{ pangolin_smtp_user }}
SMTP_PASS={{ pangolin_smtp_pass }}
SMTP_FROM={{ pangolin_smtp_user }}
