# {{ ansible_managed }}
# Pas de Persistent : une fenêtre glissante de quelques minutes à 26 h, un passage
# manqué se rattrape au suivant.
[Unit]
Description=Alerts on the VictoriaLogs logs, every 5 minutes

[Timer]
OnCalendar={{ log_alerts_schedule }}
OnActiveSec={{ log_alerts_first_run_delay }}
RandomizedDelaySec=30s

[Install]
WantedBy=timers.target
