TZ={{ jellystat_timezone }}

# Base : réseau interne `jellystat`. La base porte le nom de son utilisateur :
# l'appli se connecte d'abord sans nommer de base et tente un CREATE DATABASE,
# qui échoue en silence quand elle existe déjà.
POSTGRES_IP=jellystat-db
POSTGRES_PORT=5432
POSTGRES_DB={{ jellystat_db_name }}
POSTGRES_USER={{ jellystat_db_user }}
POSTGRES_PASSWORD={{ jellystat_db_password }}

# Signe les sessions de Jellystat (dérivé de backup_passphrase).
JWT_SECRET={{ jellystat_jwt_secret }}

# Jellyfin : ces deux variables l'emportent sur ce que l'assistant de premier
# lancement enregistre en base (backend/classes/config.js). Il reste à créer
# le compte de Jellystat dans cet assistant (README du rôle).
JF_HOST={{ jellystat_jellyfin_url }}
JF_API_KEY={{ jellystat_jellyfin_api_key }}
