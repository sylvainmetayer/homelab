# Vérification de l'accès de secours (rôle wireguard_rescue), poussée au
# moniteur « Accès de secours ». Root : wg show et nft list demandent
# CAP_NET_ADMIN. L'URL push est dans l'EnvironmentFile (0600 root).
[Unit]
Description=Daily check of the WireGuard rescue access
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/wireguard/wireguard-rescue-check.env
ExecStart=/usr/local/sbin/wireguard-rescue-check
TimeoutStartSec=2min
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
