---
# Géré par Ansible (rôle homepage) : toute modification ici est écrasée.
# Un lien par application publique (output homepage_links de
# tofu/pangolin_config) plus homepage_extra_links, chacun avec sa pastille
# d'état quand son adresse interne est connue (site_monitor), et les widgets :
# ceux de homepage_link_widgets et homepage_link_widgets_extra sur leur lien,
# une carte par hôte de Beszel, une par page de statut d'Uptime Kuma, celles
# de la supervision (sondes en panne, sauvegardes, maintenance, CrowdSec,
# Blocky), l'agenda, les passages du bus et les coûts (defaults/main.yml).
{% set widgets = {} %}
{% for key, candidate in homepage_link_widgets_extra.items() if candidate.enabled | bool and candidate.widget.url | default('') | length > 0 %}
{%   set _ = widgets.update({key: candidate.widget}) %}
{% endfor %}
{% set _ = widgets.update(homepage_link_widgets) %}
{% set links = [] %}
{% for key, link in homepage_websites.items() %}
{%   set _ = links.append(link | combine({'key': key})) %}
{% endfor %}
{% set links = links + homepage_extra_links %}
{% set cards = [] %}
{% for link in links %}
{%   set card = link | combine({'widget': widgets[link.key]} if link.key | default('') in widgets else {}) %}
{%   set monitor = link.site_monitor | default('') or homepage_link_site_monitors[link.key | default('')] | default('') %}
{%   set _ = cards.append(card | combine({'site_monitor': monitor})) %}
{% endfor %}
{% if homepage_uptimekuma_url | length > 0 %}
{%   for page in homepage_uptimekuma_status_pages %}
{%     set _ = cards.append(page | combine({'widget': {'type': 'uptimekuma', 'url': homepage_uptimekuma_url, 'slug': page.slug}})) %}
{%   endfor %}
{% endif %}
{% if homepage_kuma_summary_enabled | bool %}
{%   set _ = cards.extend(homepage_kuma_cards) %}
{% endif %}
{% if homepage_victoria_logs_widget_password | length > 0 %}
{%   set _ = cards.append(homepage_crowdsec_card) %}
{%   set _ = cards.append(homepage_blocky_card) %}
{% endif %}
{% if homepage_beszel_enabled | bool %}
{%   for system in homepage_beszel_systems %}
{%     set host = homepage_hosts[system] | default({}) %}
{%     set card = {'name': system, 'group': homepage_hosts_group, 'description': host.description | default(''), 'icon': host.icon | default(''),
                   'href': homepage_websites.beszel.href | default(''),
                   'widget': {'type': 'beszel', 'url': homepage_beszel_url, 'username': homepage_beszel_email,
                              'password': homepage_beszel_widget_password, 'version': 2, 'systemId': system,
                              'fields': homepage_beszel_host_fields}} %}
{%     if homepage_beszel_host_highlight | length > 0 %}
{%       set card = card | combine({'widget': {'highlight': homepage_beszel_host_highlight}}, recursive=true) %}
{%     endif %}
{%     if homepage_proxmox_enabled | bool and system in homepage_proxmox_guests %}
{%       set card = card | combine({'proxmox': homepage_proxmox_guests[system]}) %}
{%     endif %}
{%     set _ = cards.append(card) %}
{%   endfor %}
{% endif %}
{% if homepage_calendar_integrations | length > 0 %}
{%   set _ = cards.append(homepage_calendar_card) %}
{% endif %}
{% if 'tbm' in homepage_apps_summary_sources %}
{%   set _ = cards.append(homepage_tbm_card) %}
{% endif %}
{% if 'costs' in homepage_apps_summary_sources %}
{%   set _ = cards.append(homepage_costs_card) %}
{% endif %}
{% set groups = homepage_groups + (cards | map(attribute='group') | reject('in', homepage_groups) | unique | sort | list) %}
{% for group in groups if cards | selectattr('group', 'equalto', group) | list | length > 0 %}
- {{ group | to_json(ensure_ascii=False) }}:
{% for card in cards | selectattr('group', 'equalto', group) | sort(attribute='name') %}
    - {{ card.name | to_json(ensure_ascii=False) }}:
{% if card.href | default('') | length > 0 %}
        href: {{ card.href | to_json(ensure_ascii=False) }}
{% endif %}
{% if card.description | default('') | length > 0 %}
        description: {{ card.description | to_json(ensure_ascii=False) }}
{% endif %}
{% if card.icon | default('') | length > 0 %}
        icon: {{ card.icon | to_json(ensure_ascii=False) }}
{% endif %}
{% if card.site_monitor | default('') | length > 0 %}
        siteMonitor: {{ card.site_monitor | to_json(ensure_ascii=False) }}
{% endif %}
{% if card.proxmox is defined %}
        proxmoxNode: {{ homepage_proxmox_node | to_json }}
        proxmoxVMID: {{ card.proxmox.vmid | int }}
        proxmoxType: {{ card.proxmox.type | to_json }}
        showStats: true
{% endif %}
{% if card.widget is defined %}
        widget: {{ card.widget | to_json(ensure_ascii=False) }}
{% endif %}
{% endfor %}
{% endfor %}
