# Synchronisation S3 des sauvegardes (rclone)
S3_ENDPOINT=https://s3.{{ canary_aws_region }}.amazonaws.com
S3_BUCKET=homelab-backups-{{ inventory_hostname }}
AWS_ACCESS_KEY_ID={{ canary_cloud_tokens.env.access_key_id }}
AWS_SECRET_ACCESS_KEY={{ canary_cloud_tokens.env.secret_access_key }}
AWS_DEFAULT_REGION={{ canary_aws_region }}
