NODE_ENV=production
PORT={{ enclosed_port }}
# Pas de compte Enclosed : la création (formulaire et POST /api/notes) passe
# par le SSO de Pangolin, la lecture d'une note par les chemins ouverts de
# tofu/pangolin_config/website_enclosed.tf. Avec l'authentification
# d'Enclosed, une note publique se lirait de même, sans compte.
PUBLIC_IS_AUTHENTICATION_REQUIRED=false
# Formulaire : suppression à la lecture cochée, 1 jour, jamais sans expiration
# (le serveur refuse alors une note sans ttlInSeconds).
PUBLIC_DEFAULT_DELETE_NOTE_AFTER_READING=true
PUBLIC_DEFAULT_NOTE_TTL_SECONDS={{ enclosed_default_ttl_seconds }}
PUBLIC_IS_SETTING_NO_EXPIRATION_ALLOWED=false
NOTES_MAX_ENCRYPTED_PAYLOAD_LENGTH={{ enclosed_max_payload_bytes }}
# Purge horaire des notes expirées (défaut d'Enclosed, écrit pour mémoire).
TASK_DELETE_EXPIRED_NOTES_ENABLED=true
