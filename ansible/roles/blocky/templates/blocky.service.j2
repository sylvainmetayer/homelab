# {{ ansible_managed }}
# Blocky, filtrage DNS du LAN (rôle blocky, mode binary).
[Unit]
Description=Blocky DNS filter
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart={{ blocky_binary }} serve --config {{ blocky_config_file }}
Restart=always
RestartSec=5
Environment=GOMEMLIMIT={{ blocky_gomemlimit }}
# Compte éphémère sans privilège : le seul droit est d'ouvrir le port 53.
# StateDirectory : la copie des listes téléchargées (cachePath).
DynamicUser=yes
StateDirectory=blocky
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax={{ blocky_mem_limit | upper }}

[Install]
WantedBy=multi-user.target
