# {{ ansible_managed }}
# Alerte « aucun abonné » de ntfy (rôle ntfy), poussée au moniteur « ntfy :
# abonnés » d'Uptime Kuma. L'URL push (jeton du moniteur) est dans
# l'EnvironmentFile, 0600 root, lu par systemd avant de passer au compte du
# script : ni la ligne de commande ni systemctl show ne la montrent.
[Unit]
Description=Check that the ntfy server still has subscribers
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User={{ ntfy_subscribers_check_user }}
# docker logs.
SupplementaryGroups=docker
EnvironmentFile={{ ntfy_subscribers_check_env_file }}
# Script de push (rôle uptime_push), au chemin de uptime_push_bin.
Environment=UPTIME_PUSH={{ uptime_push_bin }}
ExecStart=/bin/sh {{ ntfy_subscribers_check_script }} ntfy {{ ntfy_subscribers_check_window_minutes | int }}
TimeoutStartSec=2min
# Lecture seule partout : le script ne fait que lire le journal par le socket
# Docker et parler à Uptime Kuma.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
