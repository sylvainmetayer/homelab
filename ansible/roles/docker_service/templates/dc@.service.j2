# Thanks https://github.com/MiGoller/dc-systemd-template#creating-docker-compose-powered-services-using-systemd-templates
[Unit]
Description=%i service powered by docker compose
# Jamais d'abandon définitif. Avec StartLimitBurst=5 sur 10 min, deux minutes
# de panne (registre injoignable au boot, Docker lent à démarrer) laissaient
# l'appli en failed jusqu'à un `systemctl --user reset-failed` manuel. Ce qui
# justifiait cette limite (un `docker compose pull` complet à chaque redémarrage
# d'une appli qui crashe en boucle) a disparu : seules les images absentes sont
# téléchargées, cf. ExecStartPre.
StartLimitIntervalSec=0
# Un échec d'un ExecStartPre (Docker absent, image introuvable) suivi d'un
# redémarrage automatique garde le job de démarrage ouvert : sans borne, un
# `systemctl --user start` (tâche Ansible comprise) attendrait indéfiniment.
# Passé ce délai le job échoue, et l'unité continue de réessayer en
# arrière-plan.
JobRunningTimeoutSec=10min
{% if docker_service_scope == 'system' %}
# Unité système : rangée après le démon Docker et ce qui le lance sur l'hôte
# (docker_service_system_after), sans le tirer par Wants=/Requires= : sur le
# NAS, docker.service est désactivé, UGOS monte /volume1 (où vit data-root)
# puis docker_serv active docker.socket ; démarrer Docker plus tôt écrirait
# ses données sur la racine. Le vrai garde-fou reste l'attente bornée de
# `docker info` ci-dessous.
After={{ docker_service_system_after | join(' ') }}
{% endif %}

[Service]
Restart=always
# 15 s fixes, sans backoff (RestartSteps=) : le compteur qui le pilote
# (NRestarts) ne revient à zéro qu'à un start manuel ou un reset-failed, jamais
# après des mois de bon fonctionnement. Chaque redémarrage du démon Docker en
# ajoute un à toutes les unités (`up` sort, ExecStop arrête les conteneurs), et
# après quelques mises à jour de Docker une appli pouvait rester arrêtée jusqu'à
# RestartMaxDelaySec à la suivante. Un `up` toutes les 15 s, sans pull, ne coûte
# presque rien à une appli qui crashe en boucle.
RestartSec=15s
# Ne borne que les ExecStartPre (attente de Docker, téléchargement des images
# absentes) : `up` (Type=simple) est considéré démarré dès son lancement.
TimeoutStartSec=300
# Le défaut (90 s) a été dépassé lors d'un arrêt de gramps sous charge.
TimeoutStopSec=120
WorkingDirectory={{ docker_base_path }}/%i

{% if docker_service_scope == 'system' %}
# After= ne fait qu'ordonner : au boot, attendre que le démon réponde, deux
# minutes au plus ; au-delà l'unité échoue et Restart= la relance.
{% else %}
# Unité *user* : elle ne peut pas se ranger After=docker.service (unité du
# manager système). Au boot, attendre que le démon réponde, deux minutes au
# plus ; au-delà l'unité échoue et Restart= la relance.
{% endif %}
ExecStartPre=/usr/bin/timeout 120 /bin/sh -c 'until /usr/bin/docker info >/dev/null 2>&1; do sleep 2; done'

# Ne télécharge que les images absentes, sans interroger le registre pour
# celles déjà là : un registre en panne n'empêche plus de (re)démarrer une
# appli déjà déployée, là où l'ancien `docker compose pull` complet était
# fatal. Les mises à jour passent toujours : les images sont épinglées par
# digest (Renovate, pinDigests), un nouveau digest est une image absente.
# En ExecStartPre et pas dans `up` : un téléchargement qui échoue (digest
# introuvable, tag mal saisi, registre en panne pendant un déploiement) fait
# échouer le job de démarrage, donc le handler `Restart <service>` d'Ansible,
# au lieu d'un `up` (Type=simple, déjà « démarré ») qui échoue en silence.
ExecStartPre=/usr/bin/docker compose pull --policy missing

# Pas d'option --pull : chaque service suit son `pull_policy`, « missing »
# par défaut (les images sont déjà là, cf. ci-dessus). Une image sur un tag
# mobile ne serait en revanche plus rafraîchie : l'épingler, ou lui donner
# `pull_policy: always` dans son compose (banc KC de flip_planning), que
# `up` applique à chaque démarrage. `--pull missing` ici écraserait ce
# réglage pour tous les services.
# --remove-orphans : supprime les conteneurs d'un service retiré du compose.
#
# `up` recopie sur sa sortie standard chaque ligne de chaque conteneur
# (« conteneur-1  | ligne ») : ~80 % du journal, donc des écritures de journald
# (~50 Ko/s pour ~250 o/s de texte sur la VM docker), pour des lignes que le
# pilote json-file de Docker garde déjà (et que log_agent lit à la source).
# grep les retire et laisse passer le reste (« Attaching to … »,
# « conteneur-1 exited with code N », création, démarrage et arrêt des
# conteneurs, erreurs de compose, qui ne portent pas ce préfixe). `up` écrit
# sur sa sortie d'erreur les lignes que le conteneur écrit sur la sienne
# (homebox, homepage-*, tout ce qui journalise sur stderr) : relevées dans le
# journal de la VM docker le 2026-11-13, 56 % des entrées du manager user
# (« homebox  | request finished »), d'où le `2>&1`. Ni `--no-attach` (`up` rend la main dès que les conteneurs
# attachés s'arrêtent, et les attache tous si on les exclut tous) ni
# LogFilterPatterns= (sans effet dans une unité user, absent du systemd 252
# du NAS) ne conviennent. -a : une ligne binaire ne coupe pas la sortie de
# grep. `exit $${PIPESTATUS[0]}` (`$$` : un `$` pour systemd) rend le code de
# sortie de `up`, pas celui de grep (1 s'il n'a rien laissé passer).
# /bin/bash et /bin/grep (comme /bin/sh plus haut) : présents que /usr soit
# fusionné ou non (UGOS sur le NAS).
ExecStart=/bin/bash -c '/usr/bin/docker compose up --remove-orphans 2>&1 | /bin/grep -a --line-buffered -v -E "^[A-Za-z0-9][A-Za-z0-9_.-]* +[|]"; exit "$${PIPESTATUS[0]}"'
# `stop`, pas `down`, délibérément : `down` supprimerait les conteneurs, et
# avec eux le contenu des volumes anonymes (VOLUME d'une image que le compose
# ne monte pas) au prochain `up`. Les conteneurs arrêtés sont marqués « stoppés
# par l'utilisateur » : Docker ne les relance pas de lui-même au boot, c'est
# cette unité qui le fait (et elle n'abandonne plus, cf. StartLimitIntervalSec).
ExecStop=/usr/bin/docker compose stop

[Install]
{% if docker_service_scope == 'system' %}
WantedBy=multi-user.target
{% else %}
# Unité *user* : son manager n'a pas de multi-user.target, seulement
# default.target, atteint au démarrage grâce au lingering.
WantedBy=default.target
{% endif %}
