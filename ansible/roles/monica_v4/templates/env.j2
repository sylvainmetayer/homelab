# Écrit par le rôle monica_v4 : une modification à la main est écrasée au
# prochain passage. Variables lues par Monica 3.7 (config/*.php de l'image).
APP_ENV=production
APP_DEBUG=false
APP_KEY={{ monica_v4_app_key }}
HASH_SALT={{ monica_v4_hash_salt }}
HASH_LENGTH=18
APP_URL=https://{{ monica_v4_domain }}
APP_FORCE_URL=false
APP_TRUST_PROXIES={{ monica_v4_trusted_proxies | join(',') }}
APP_TRUSTED_CLOUDFLARE=false

DB_CONNECTION=mysql
DB_HOST=monica_v4_db
DB_PORT=3306
DB_DATABASE=monica
DB_USERNAME=monica
DB_PASSWORD={{ monica_v4_db_password }}
DB_PREFIX=
DB_USE_UTF8MB4=true

MAIL_MAILER=smtp
MAIL_HOST=mail.infomaniak.com
MAIL_PORT=465
MAIL_USERNAME={{ pangolin_smtp_user }}
MAIL_PASSWORD={{ pangolin_smtp_pass }}
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=no-reply@sylvainmetayer.fr
MAIL_FROM_NAME="Monica instance"
APP_EMAIL_NEW_USERS_NOTIFICATION=

# Compte unique : pas d'inscription.
APP_DISABLE_SIGNUP=true
APP_SIGNUP_DOUBLE_OPTIN=false
MFA_ENABLED=true
# /dav reste fermé : ses chemins sont aussi coupés dans Pangolin
# (php_lockdown.tf, tofu/pangolin_config).
DAV_ENABLED=false

LOG_CHANNEL=daily
SENTRY_SUPPORT=false
CHECK_VERSION=true
ALLOW_STATISTICS_THROUGH_PUBLIC_API_ACCESS=false
POLICY_COMPLIANT=true
ENABLE_GEOLOCATION=false
ENABLE_WEATHER=false

CACHE_DRIVER=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
DEFAULT_MAX_UPLOAD_SIZE=10240
DEFAULT_MAX_STORAGE_SIZE=512
DEFAULT_FILESYSTEM=public
