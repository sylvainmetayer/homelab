# Monica v4 cron service
[Unit]
Description=Monica v4 cron service

[Service]
Type=oneshot
WorkingDirectory={{ monica_v4_base_path }}

ExecStart=/usr/bin/docker compose -f {{ monica_v4_base_path }}/compose.yaml exec -T crm sh -c 'php artisan schedule:run'
{% if monica_v4_cron_healthcheck_url %}
# Push « up » après schedule:run seulement (ExecStartPost ne part que si
# ExecStart a réussi) : un cron en échec ne pousse rien et le moniteur
# « Cron Monica » passe au rouge à l'échéance. URL push (jeton du moniteur)
# lue dans un fichier de configuration curl, pas sur la ligne de commande :
# journald attache celle-ci (_CMDLINE) à chaque ligne que sort curl, et ps et
# systemctl show la montrent. --strict : un push raté fait échouer l'unité
# (visible dans le journal), le cron a déjà tourné.
ExecStartPost={{ uptime_push_bin }} --strict --agent monica-cron {{ monica_v4_cron_push_config }} up
{% endif %}
