PUID={{ ansible_facts['user_uid'] }}
PGID={{ ansible_facts['user_gid'] }}
TZ=Europe/Paris
APP_KEY={{ speedtest_tracker_app_key }}
# Derrière Pangolin (Traefik, puis newt) : l'URL publique des liens, des
# assets et des notifications, toujours en https.
APP_URL=https://{{ speedtest_tracker_domain }}
ASSET_URL=https://{{ speedtest_tracker_domain }}
FORCE_HTTPS=true
DB_CONNECTION=sqlite
# Les dates restent stockées en UTC (APP_TIMEZONE par défaut) ; l'affichage
# et le cron des tests sont à l'heure de Paris.
DISPLAY_TIMEZONE=Europe/Paris
APP_LOCALE=fr_FR
SPEEDTEST_SCHEDULE="{{ speedtest_tracker_schedule }}"
PRUNE_RESULTS_OLDER_THAN={{ speedtest_tracker_prune_results_older_than }}
# Tableau de bord réservé aux comptes (le défaut, écrit pour qu'il ne change
# pas sans se voir) : le SSO de Pangolin n'est pas la seule barrière.
PUBLIC_DASHBOARD=false
# Lus par la première migration seulement (defaults/main.yml).
ADMIN_NAME=Sylvain
ADMIN_EMAIL={{ speedtest_tracker_admin_email }}
ADMIN_PASSWORD={{ speedtest_tracker_admin_password }}
# Seuils d'alerte désactivés : la première migration les écrit en base, la
# suite se règle dans l'interface (Settings > Thresholds), avec un canal de
# notification (Settings > Notifications), aucun ne se configurant par
# l'environnement.
THRESHOLD_ENABLED=false
