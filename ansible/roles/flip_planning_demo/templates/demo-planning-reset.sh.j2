#!/bin/sh
# {{ ansible_managed }} — rôle flip_planning_demo, ADR 0038.
# Remet la démo publique au dump de référence, comme le dit la doc de l'appli
# (installer/instance-de-demo.md) : arrêt de l'appli, base supprimée puis
# recréée (un `pg_restore --clean` laisserait une table plus récente que le
# dump, qui ferait échouer la migration suivante), restauration, puis appli
# recréée, échec ou non : ses journaux ne couvrent ainsi qu'une demi-heure.
set -eu
cd "{{ docker_base_path }}/{{ flip_planning_demo_service }}"
db="{{ flip_planning_demo_container_prefix }}-db"
dump="{{ flip_planning_demo_reset_dir }}/reference.dump"
user="{{ flip_planning_demo_db_user }}"
name="{{ flip_planning_demo_db_name }}"
[ -s "$dump" ] || { echo "demo-planning-reset : $dump absent, voir le README du rôle" >&2; exit 1; }
stopped=0
# Quelle que soit la sortie (échec d'une commande, arrêt par systemd après
# TimeoutStartSec) : l'appli n'est jamais laissée arrêtée jusqu'à la remise suivante.
cleanup() {
  [ "$stopped" -eq 0 ] || docker compose up --detach --force-recreate --no-deps app || true
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

stopped=1
docker compose stop app
# --force : coupe aussi une restauration d'une remise tuée (tuer `docker exec`
# laisse tourner pg_restore dans le conteneur).
docker exec "$db" dropdb -U "$user" --if-exists --force "$name"
docker exec "$db" createdb -U "$user" -O "$user" "$name"
docker exec -i "$db" pg_restore -U "$user" -d "$name" --no-owner --role="$user" --exit-on-error < "$dump"
