#!/usr/sbin/nft -f
# {{ ansible_managed }} — rôle flip_planning_demo, ADR 0038.
# Sortie de l'hôte de la démo publique. Sa propre table, remplacée d'un bloc :
# les règles de Docker et d'ufw (leurs tables) ne sont pas touchées. Une base
# chain à policy drop s'ajoute aux leurs : un paquet doit passer toutes.
table inet demo_egress
delete table inet demo_egress
table inet demo_egress {
  set host_tcp { type inet_service; elements = { {{ flip_planning_demo_host_tcp_ports | join(', ') }} } }
  set host_udp { type inet_service; elements = { {{ flip_planning_demo_host_udp_ports | join(', ') }} } }
  set pangolin_udp { type inet_service; elements = { {{ flip_planning_demo_pangolin_udp_ports | join(', ') }} } }

  # L'hôte : apt, images, DNS, NTP. Rien vers les réseaux privés ; les
  # réponses SSH à Pangolin (le rebond d'Ansible) sont `established`.
  chain output {
    type filter hook output priority filter; policy drop;
    oif lo accept
    ct state established,related accept
    # Découverte de voisins et ICMPv6 : sans eux, l'IPv6 de l'hôte ne marche pas.
    meta l4proto ipv6-icmp accept
    udp dport 67 accept
    oifname "docker0" accept
    oifname "br-*" accept
    ip daddr { {{ flip_planning_demo_private_networks | join(', ') }} } drop
    tcp dport @host_tcp accept
    udp dport @host_udp accept
  }

  # Les conteneurs : entre eux (ponts Docker), vers les résolveurs DNS (le DNS
  # embarqué de Docker interroge depuis l'espace de noms du conteneur : sans
  # cette règle le newt ne résout pas Pangolin), et vers Pangolin seul — le
  # newt, en HTTPS et en WireGuard (gerbil), plus HTTPS vers les seuls noms de
  # flip_planning_demo_https_hosts (Bugsink). L'appli n'atteint rien d'autre :
  # ni SMTP, ni webhook, ni API tierce, quoi que dise son environnement.
  chain forward {
    type filter hook forward priority filter; policy drop;
    ct state established,related accept
    oifname "docker0" accept
    oifname "br-*" accept
    ip daddr { {{ flip_planning_demo_dns_servers | join(', ') }} } udp dport 53 accept
    ip daddr { {{ flip_planning_demo_dns_servers | join(', ') }} } tcp dport 53 accept
    ip daddr {{ flip_planning_demo_pangolin_ip }} tcp dport 443 accept
    ip daddr {{ flip_planning_demo_pangolin_ip }} udp dport @pangolin_udp accept
{% if flip_planning_demo_https_ips | default([]) | length > 0 %}
    # {{ flip_planning_demo_https_hosts | join(', ') }} (defaults/main.yml).
    ip daddr { {{ flip_planning_demo_https_ips | join(', ') }} } tcp dport 443 accept
{% endif %}
  }
}
