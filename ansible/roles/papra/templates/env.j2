NODE_ENV=production
TZ=Europe/Paris
# URL publique : celle des liens, des cookies et de l'origine acceptée.
APP_BASE_URL=https://{{ papra_domain }}
AUTH_SECRET={{ papra_auth_secret }}
# Ouverte seulement le temps de créer le premier compte (defaults/main.yml).
AUTH_IS_REGISTRATION_ENABLED={{ papra_registration_enabled | bool | string | lower }}
# Aucun e-mail ne part (EMAILS_DRY_RUN) : pas de réinitialisation par e-mail.
AUTH_IS_PASSWORD_RESET_ENABLED=false
EMAILS_DRY_RUN=true
DOCUMENTS_OCR_LANGUAGES={{ papra_ocr_languages | join(',') }}
DOCUMENT_STORAGE_MAX_UPLOAD_SIZE={{ papra_max_upload_size }}
INGESTION_FOLDER_IS_ENABLED={{ papra_ingestion_enabled | bool | string | lower }}
# Pas de statistiques envoyées à PostHog (défaut, écrit pour être sûr).
POSTHOG_ENABLED=false
