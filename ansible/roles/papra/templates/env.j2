NODE_ENV=production
TZ=Europe/Paris
# URL publique : celle des liens, des cookies et de l'origine acceptée.
APP_BASE_URL=https://{{ papra_domain }}
AUTH_SECRET={{ papra_auth_secret }}
# Ouverte seulement le temps de créer le premier compte (defaults/main.yml).
AUTH_IS_REGISTRATION_ENABLED={{ papra_registration_enabled | bool | string | lower }}
# E-mails réels (invitations, mot de passe oublié) par le relais Infomaniak,
# même compte que karakeep / dawarich / meerkat_crm. EMAILS_DRY_RUN n'existe
# plus en 26.x : EMAILS_DRIVER (logger par défaut) le remplace.
AUTH_IS_PASSWORD_RESET_ENABLED=true
EMAILS_DRIVER=smtp
EMAILS_FROM_ADDRESS=Papra <{{ pangolin_smtp_user }}>
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER={{ pangolin_smtp_user }}
SMTP_PASSWORD={{ pangolin_smtp_pass }}
DOCUMENTS_OCR_LANGUAGES={{ papra_ocr_languages | join(',') }}
DOCUMENT_STORAGE_MAX_UPLOAD_SIZE={{ papra_max_upload_size }}
DOCUMENTS_DELETED_DOCUMENTS_RETENTION_DAYS={{ papra_deleted_documents_retention_days }}
# Fichiers rangés sous leur nom (<organisation>/<nom du document>) au lieu
# de <organisation>/originals/<id> : une restauration borg brute reste
# lisible. Seuls les nouveaux documents ; les anciens gardent leur clé.
# Le motif est le défaut de Papra, écrit pour le figer ; ses accolades sont
# échappées pour Jinja (rendu littéral vérifié par Molecule).
DOCUMENT_STORAGE_USE_LEGACY_STORAGE_KEY_DEFINITION_SYSTEM=false
DOCUMENT_STORAGE_KEY_PATTERN={{ '{{' }}organization.id{{ '}}' }}/{{ '{{' }}document.name{{ '}}' }}
# File des tâches (OCR, règles, retraitement) dans une base SQLite du volume :
# en mémoire (défaut de Papra), un redémarrage perdait les tâches en attente.
# Seule la tâche en cours au redémarrage reste « processing » (README).
# Dans app-data/db/ : le glob *.sqlite de la sauvegarde en fait une copie
# cohérente (VACUUM INTO, base en WAL), à partir du déploiement suivant sa
# création.
TASKS_PERSISTENCE_DRIVER=libsql
TASKS_PERSISTENCE_DRIVERS_LIBSQL_URL=file:/app/app-data/db/tasks.sqlite
INGESTION_FOLDER_IS_ENABLED={{ papra_ingestion_enabled | bool | string | lower }}
# Pas de statistiques envoyées à PostHog (défaut, écrit pour être sûr).
POSTHOG_ENABLED=false
