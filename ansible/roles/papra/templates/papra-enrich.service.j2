# {{ ansible_managed }}
# Remplissage par l'IA des documents Papra (rôle papra, tasks/enrich.yml).
# Clés dans {{ papra_enrich_config_file }} (0600, au compte de l'unité), jamais
# sur la ligne de commande : ni ps ni systemctl show ne les montrent.
[Unit]
Description=Fill Papra amounts, expiry dates and tags through the AI gateway
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User={{ ansible_user }}
# docker inspect : l'IP de Papra sur le réseau newt (aucun port publié).
SupplementaryGroups=docker
ExecStart=/usr/bin/python3 -I {{ papra_enrich_script }} --config {{ papra_enrich_config_file }}
TimeoutStartSec=30min
# Lecture seule partout : le script n'écrit que par l'API de Papra.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
