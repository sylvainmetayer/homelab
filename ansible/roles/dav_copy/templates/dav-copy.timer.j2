# {{ ansible_managed }}
# Persistent rattrape un passage manqué ; la copie est idempotente.
[Unit]
Description=One-way copy of Nextcloud calendars and contacts to Infomaniak, hourly

[Timer]
OnCalendar={{ dav_copy_schedule }}
OnActiveSec={{ dav_copy_first_run_delay }}
RandomizedDelaySec=5min
Persistent=true

[Install]
WantedBy=timers.target
