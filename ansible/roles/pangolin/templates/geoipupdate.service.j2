# Mise à jour des bases GeoLite2 de pangolin_geoip_dir, par l'image officielle
# de MaxMind épinglée : Country, lue par Pangolin (géofiltre de toutes les
# ressources publiques), City, lue par Pocket ID (lieux du journal d'audit).
# Pangolin ne relit sa base qu'au démarrage : il est redémarré seulement si
# Country a changé ; Pocket ID surveille le dossier et recharge seul. Un
# succès est signalé au moniteur push Uptime Kuma (tofu/pangolin_config,
# « GeoIP Pangolin ») ; sans signal, il passe au rouge.
[Unit]
Description=GeoLite2 update for Pangolin
Wants=docker.service network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c '\
  before=$(sha256sum {{ pangolin_geoip_dir }}/GeoLite2-Country.mmdb 2>/dev/null); \
  /usr/bin/docker run --rm \
    --env-file {{ pangolin_geoipupdate_config_dir }}/env \
    -v {{ pangolin_geoipupdate_config_dir }}/license_key:/run/secrets/license_key:ro \
    -v {{ pangolin_geoip_dir }}:/usr/share/GeoIP \
    {{ pangolin_geoipupdate_image }} || exit 1; \
  after=$(sha256sum {{ pangolin_geoip_dir }}/GeoLite2-Country.mmdb); \
  if [ "$before" != "$after" ] && /usr/bin/docker inspect pangolin >/dev/null 2>&1; then \
    /usr/bin/docker restart pangolin; \
  fi'
{% if pangolin_geoip_healthcheck_url %}
# URL push (jeton du moniteur) lue dans un fichier de configuration curl,
# jamais sur la ligne de commande (ps, systemctl show, _CMDLINE du journal).
# --strict : un push raté fait échouer l'unité (systemctl --failed).
ExecStartPost={{ uptime_push_bin }} --strict --agent geoipupdate {{ pangolin_geoipupdate_config_dir }}/push.curl up
{% endif %}
