http:
  middlewares:
    badger:
      plugin:
        badger:
          disableForwardAuth: true
    redirect-to-https:
      redirectScheme:
        scheme: https
    # En-têtes de toutes les réponses HTTPS (entrypoint websecure,
    # traefik_config.yml). HSTS sans includeSubDomains ni preload : nas.,
    # media. et mediamanager.sylvain.cloud sont servis par le Traefik du NAS,
    # hors de ce proxy, et une entrée preload ne se retire pas. Server et
    # X-Powered-By vidés : Betisier y annonçait nginx et PHP à la version
    # près, Immich et le tableau de bord leur framework. Les applis qui posent
    # leur propre HSTS le voient remplacé par celui-ci.
    security-headers:
      headers:
        stsSeconds: 31536000
        customResponseHeaders:
          Server: ""
          X-Powered-By: ""
{% if pangolin_crowdsec_enabled %}
    # Bouncer CrowdSec, sur tout l'entrypoint websecure (traefik_config.yml).
    # Mode stream : la liste des décisions est tirée de la LAPI toutes les
    # 15 s et gardée en mémoire, aucune requête n'attend la LAPI. Il laisse
    # passer quand CrowdSec est injoignable (updateMaxFailure: -1, appels
    # AppSec en échec ou injoignables) : CrowdSec en panne ne coupe pas
    # Pangolin, il ne protège plus. docs/runbooks/crowdsec.md.
    crowdsec:
      plugin:
        crowdsec:
          enabled: true
          logLevel: INFO
          crowdsecMode: stream
          updateIntervalSeconds: 15
          updateMaxFailure: -1
          # Premier tirage en arrière-plan : Traefik ne l'attend pas pour
          # charger sa configuration quand CrowdSec démarre encore.
          streamStartupBlock: false
          crowdsecLapiScheme: http
          crowdsecLapiHost: crowdsec:8080
          crowdsecLapiKey: "{{ pangolin_crowdsec_bouncer_key }}"
{% if pangolin_crowdsec_appsec_enabled %}
          # AppSec en détection seule (règles hors bande, toujours 200). Les
          # trois *Block à false : une erreur ou un corps illisible (HTTP/2
          # sans Content-Length) laisse passer au lieu de répondre 403.
          crowdsecAppsecEnabled: true
          crowdsecAppsecHost: crowdsec:7422
          crowdsecAppsecFailureBlock: false
          crowdsecAppsecUnreachableBlock: false
          crowdsecAppsecUnreadableBodyBlock: false
          crowdsecAppsecBodyLimit: {{ pangolin_crowdsec_appsec_body_limit }}
{% else %}
          crowdsecAppsecEnabled: false
{% endif %}
          # Pas de forwardedHeadersTrustedIPs : l'IP du client est celle de la
          # connexion, jamais un X-Forwarded-For (traefik_config.yml).
          # Jamais bloquées, liste communautaire et décisions manuelles
          # comprises : les mêmes sources que la liste blanche de CrowdSec
          # (homelab-whitelist.yaml), qui, elle, ne couvre que la détection.
          clientTrustedIPs:
{% for cidr in pangolin_crowdsec_trusted_cidrs %}
            - "{{ cidr }}"
{% endfor %}
{% else %}
    # CrowdSec désactivé : un middleware du même nom qui ne fait rien (il
    # retire un en-tête que personne n'envoie ; `headers: {}` vide est refusé
    # et ferait rejeter tout ce fichier). Ce fichier est relu tout de suite,
    # la configuration statique seulement au redémarrage de la pile (handlers
    # vidés en fin de rôle) : d'ici là, l'entrypoint websecure désigne encore
    # crowdsec@file, et un
    # middleware absent mettrait toutes les routes en erreur.
    crowdsec:
      headers:
        customRequestHeaders:
          X-Crowdsec-Disabled: ""
{% endif %}
    # API d'intégration (admin complet de Pangolin, int-api-router) : maison
    # et Pangolin lui-même (sortie de la passerelle vpn-flip, NAT de flip),
    # clé pangolin_api_allowed_ips de secrets/ansible.sops.yaml (plages séparées par
    # des virgules : sops set n'écrit pas de liste). tofu apply de
    # pangolin_config depuis la maison ou par une passerelle VPN.
    int-api-allowlist:
      ipAllowList:
        sourceRange:
{% for range in pangolin_api_allowed_ips.split(',') | map('trim') | select %}
          - "{{ range }}"
{% endfor %}
{% if pangolin_idp_host | length > 0 %}

    # Fournisseur d'identité (pangolin_idp_host) : débit par IP, et, avant le
    # premier compte administrateur, la seule IP de la maison.
    pocket-id-ratelimit:
      rateLimit:
        average: {{ pangolin_idp_rate_average }}
        period: 1s
        burst: {{ pangolin_idp_rate_burst }}

    # En-têtes propres à Pocket ID, en plus de security-headers (HSTS) de
    # l'entrypoint ; l'anti-iframe vient de sa CSP (frame-ancestors 'none').
    # Permissions-Policy garde WebAuthn (passkeys) pour la page elle-même.
    # CORP same-site : les applis de *.sylvain.cloud affichent l'avatar
    # (claim picture). Pas de Cross-Origin-Opener-Policy : la connexion de
    # Beszel (PocketBase) ouvre Pocket ID dans une fenêtre surgissante, que
    # COOP couperait de la page qui l'a ouverte.
    pocket-id-headers:
      headers:
        contentTypeNosniff: true
        referrerPolicy: "strict-origin-when-cross-origin"
        permissionsPolicy: "camera=(), microphone=(), geolocation=(), payment=(), usb=(), publickey-credentials-get=(self), publickey-credentials-create=(self)"
        customResponseHeaders:
          Cross-Origin-Resource-Policy: "same-site"
{% if pangolin_idp_allowed_ips | length > 0 %}

    pocket-id-allowlist:
      ipAllowList:
        sourceRange:
{% for range in pangolin_idp_allowed_ips.split(',') | map('trim') | select %}
          - "{{ range }}"
{% endfor %}
{% endif %}
{% endif %}
{% for sw in pangolin_service_worker_retirements %}

    # Service worker de retrait de {{ sw.host }} (à retirer après {{ sw.remove_after }}).
    sw-retire-{{ sw.name }}:
      replacePath:
        path: "{{ sw.replacement }}"
{% endfor %}

  routers:
    # https://docs.pangolin.net/self-host/advanced/integration-api
    # Add the following two routers
    int-api-router-redirect:
      rule: "Host(`{{ pangolin_api_url }}`)"
      service: int-api-service
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
        - badger # If you have Badger >=1.3.0 and it's enabled in the middlewares section of the dynamic config

    int-api-router:
      rule: "Host(`{{ pangolin_api_url }}`)"
      service: int-api-service
      entryPoints:
        - websecure
      middlewares:
        - int-api-allowlist
      # Ancre reprise par les routeurs fichier de sylvain.cloud (tableau de
      # bord, Pocket ID) : le joker du domaine quand pangolin_wildcard_cert
      # (ADR 0031), sinon un certificat par nom en HTTP-01.
      tls: &tls-base-domain
{% if pangolin_wildcard_cert | bool %}
        certResolver: {{ pangolin_wildcard_resolver }}
        domains:
          - main: "*.{{ pangolin_base_domain }}"
{% else %}
        certResolver: letsencrypt
{% endif %}

    # HTTP to HTTPS redirect router
    main-app-router-redirect:
      rule: "Host(`{{ pangolin_dashboard_url }}`)"
      service: next-service
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
        - badger

    # Next.js router (handles everything except API and WebSocket paths)
    next-router:
      rule: "Host(`{{ pangolin_dashboard_url }}`) && !PathPrefix(`/api/v1`)"
      service: next-service
      entryPoints:
        - websecure
      middlewares:
        - badger
      tls: *tls-base-domain

    # API router (handles /api/v1 paths)
    api-router:
      rule: "Host(`{{ pangolin_dashboard_url }}`) && PathPrefix(`/api/v1`)"
      service: api-service
      entryPoints:
        - websecure
      middlewares:
        - badger
      tls: *tls-base-domain

    # WebSocket router
    ws-router:
      rule: "Host(`{{ pangolin_dashboard_url }}`)"
      service: api-service
      entryPoints:
        - websecure
      middlewares:
        - badger
      tls: *tls-base-domain

{% if pangolin_idp_host | length > 0 %}
    # Fournisseur d'identité (rôle pocket_id) : ni badger ni mur SSO, il sert
    # le login de ce mur. Le conteneur est sur le réseau « pangolin » du
    # compose, comme Pangolin lui-même. security-headers et crowdsec viennent de
    # l'entrypoint websecure ; aucun filtre pays (ADR 0030, exception à 0002).
    pocket-id-router-redirect:
      rule: "Host(`{{ pangolin_idp_host }}`)"
      service: pocket-id-service
      entryPoints:
        - web
      middlewares:
        - redirect-to-https

    pocket-id-router:
      rule: "Host(`{{ pangolin_idp_host }}`)"
      service: pocket-id-service
      entryPoints:
        - websecure
      middlewares:
{% if pangolin_idp_allowed_ips | length > 0 %}
        - pocket-id-allowlist
{% endif %}
        - pocket-id-ratelimit
        - pocket-id-headers
      tls: *tls-base-domain

{% endif %}
{% if pangolin_wildcard_staging | bool %}
    # Essai du joker sur l'autorité de test (pangolin_wildcard_staging) : la
    # commande part de ce routeur ; aucun certificat par nom ne couvre ce nom,
    # le joker de test est donc celui servi (émetteur « (STAGING) »).
    acme-staging-test:
      rule: "Host(`{{ pangolin_wildcard_test_host }}`)"
      service: noop@internal
      entryPoints:
        - websecure
      tls:
        certResolver: letsencrypt-dns-staging
        domains:
          - main: "*.{{ pangolin_base_domain }}"

{% endif %}
{% for sw in pangolin_service_worker_retirements %}
    # {{ sw.host }} est redirigé par Pangolin (redirects.tf), mais un
    # navigateur refuse de mettre à jour un service worker derrière une
    # redirection : ce chemin sert à la place un worker qui se désinstalle.
    # Priorité explicite : Pangolin place ses routeurs de redirection dans la
    # bande 1001-2000 (computeRedirectPriority = priorité de route, plafonnée
    # à 1000, + REDIRECT_PRIORITY_OFFSET 1000 : server/lib/traefik/rule.ts en
    # 1.25.3), au-dessus de toute ressource. Le worker passe au-dessus.
    sw-retire-{{ sw.name }}:
      rule: "Host(`{{ sw.host }}`) && Path(`{{ sw.path }}`)"
      priority: 3000
      service: sw-retire-{{ sw.name }}
      entryPoints:
        - websecure
      middlewares:
        - sw-retire-{{ sw.name }}
      tls:
        certResolver: letsencrypt

{% endfor %}
  services:
    int-api-service:
      loadBalancer:
        servers:
          - url: "http://pangolin:3003"

    next-service:
      loadBalancer:
        servers:
          - url: "http://pangolin:3002"  # Next.js server

    api-service:
      loadBalancer:
        servers:
          - url: "http://pangolin:3000"  # API/WebSocket server
{% if pangolin_idp_host | length > 0 %}

    pocket-id-service:
      loadBalancer:
        servers:
          - url: "{{ pangolin_idp_upstream }}"
{% endif %}
{% for sw in pangolin_service_worker_retirements %}

    sw-retire-{{ sw.name }}:
      loadBalancer:
        passHostHeader: false
        servers:
          - url: "{{ sw.target }}"
{% endfor %}

# Option TLS « default » : valable pour tous les noms publics (ressources
# Pangolin, tableau de bord, Pocket ID). TLS 1.3 n'est pas concerné par
# cipherSuites ; en 1.2 on ne garde que ECDHE + AEAD (pas de CBC, LUCKY13).
tls:
  options:
    default:
      minVersion: VersionTLS12
      cipherSuites:
        - TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
        - TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
        - TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
        - TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
        - TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256
        - TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256

tcp:
  serversTransports:
    pp-transport-v1:
      proxyProtocol:
        version: 1
    pp-transport-v2:
      proxyProtocol:
        version: 2
