http:
  middlewares:
    badger:
      plugin:
        badger:
          disableForwardAuth: true
    redirect-to-https:
      redirectScheme:
        scheme: https
{% for redirect in pangolin_domain_redirects %}

    # {{ redirect.host }} -> {{ redirect.target }} (301, chemin conservé). Le
    # routeur choisit déjà l'hôte : la regex accepte n'importe lequel (casse,
    # port explicite, point final), sinon la requête tomberait sur noop@internal.
    redirect-{{ redirect.name }}:
      redirectRegex:
        regex: '^https?://[^/]+(/.*)?$'
        replacement: "{{ redirect.target }}${1}"
        permanent: true
{% if redirect.service_worker is defined %}

    redirect-{{ redirect.name }}-sw:
      replacePath:
        path: "{{ redirect.service_worker.replacement }}"
{% endif %}
{% endfor %}

  routers:
    # https://docs.pangolin.net/self-host/advanced/integration-api
    # Add the following two routers
    int-api-router-redirect:
      rule: "Host(`{{ pangolin_api_url }}`)"
      service: int-api-service
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
        - badger # If you have Badger >=1.3.0 and it's enabled in the middlewares section of the dynamic config

    int-api-router:
      rule: "Host(`{{ pangolin_api_url }}`)"
      service: int-api-service
      entryPoints:
        - websecure
      tls:
        certResolver: letsencrypt

    # HTTP to HTTPS redirect router
    main-app-router-redirect:
      rule: "Host(`{{ pangolin_dashboard_url }}`)"
      service: next-service
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
        - badger

    # Next.js router (handles everything except API and WebSocket paths)
    next-router:
      rule: "Host(`{{ pangolin_dashboard_url }}`) && !PathPrefix(`/api/v1`)"
      service: next-service
      entryPoints:
        - websecure
      middlewares:
        - badger
      tls:
        certResolver: letsencrypt

    # API router (handles /api/v1 paths)
    api-router:
      rule: "Host(`{{ pangolin_dashboard_url }}`) && PathPrefix(`/api/v1`)"
      service: api-service
      entryPoints:
        - websecure
      middlewares:
        - badger
      tls:
        certResolver: letsencrypt

    # WebSocket router
    ws-router:
      rule: "Host(`{{ pangolin_dashboard_url }}`)"
      service: api-service
      entryPoints:
        - websecure
      middlewares:
        - badger
      tls:
        certResolver: letsencrypt

{% for redirect in pangolin_domain_redirects %}
    # Redirection de domaine entier (pangolin_domain_redirects) : HTTP et HTTPS
    # vont directement vers la cible, sans passer par redirect-to-https.
    redirect-{{ redirect.name }}-web:
      rule: "Host(`{{ redirect.host }}`)"
      service: noop@internal
      entryPoints:
        - web
      middlewares:
        - redirect-{{ redirect.name }}

    redirect-{{ redirect.name }}:
      rule: "Host(`{{ redirect.host }}`)"
      service: noop@internal
      entryPoints:
        - websecure
      middlewares:
        - redirect-{{ redirect.name }}
      tls:
        certResolver: letsencrypt
{% if redirect.service_worker is defined %}

    # Un navigateur refuse de mettre à jour un service worker derrière une
    # redirection : celui que l'ancien site a installé sur ce domaine
    # resterait actif et servirait son cache. Ce chemin sert à la place un
    # worker qui se désinstalle (règle plus longue, donc prioritaire).
    redirect-{{ redirect.name }}-sw:
      rule: "Host(`{{ redirect.host }}`) && Path(`{{ redirect.service_worker.path }}`)"
      service: redirect-{{ redirect.name }}-sw
      entryPoints:
        - websecure
      middlewares:
        - redirect-{{ redirect.name }}-sw
      tls:
        certResolver: letsencrypt
{% endif %}

{% endfor %}
  services:
    int-api-service:
      loadBalancer:
        servers:
          - url: "http://pangolin:3003"

    next-service:
      loadBalancer:
        servers:
          - url: "http://pangolin:3002"  # Next.js server

    api-service:
      loadBalancer:
        servers:
          - url: "http://pangolin:3000"  # API/WebSocket server
{% for redirect in pangolin_domain_redirects if redirect.service_worker is defined %}

    redirect-{{ redirect.name }}-sw:
      loadBalancer:
        passHostHeader: false
        servers:
          - url: "{{ redirect.target }}"
{% endfor %}

tcp:
  serversTransports:
    pp-transport-v1:
      proxyProtocol:
        version: 1
    pp-transport-v2:
      proxyProtocol:
        version: 2
