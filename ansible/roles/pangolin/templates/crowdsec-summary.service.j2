# {{ ansible_managed }}
# Résumé hebdomadaire des alertes CrowdSec sur ntfy (topic
# {{ pangolin_crowdsec_summary_ntfy_topic }}) : /usr/local/bin/crowdsec-summary,
# docs/runbooks/crowdsec.md. Le jeton ntfy est dans l'EnvironmentFile (0600),
# jamais sur une ligne de commande.
[Unit]
Description=Weekly CrowdSec summary to ntfy
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
EnvironmentFile={{ pangolin_crowdsec_summary_config_dir }}/env
ExecStart=/usr/bin/python3 -I /usr/local/bin/crowdsec-summary
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
