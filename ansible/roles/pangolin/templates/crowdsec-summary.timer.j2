# {{ ansible_managed }}
# Chaque lundi matin (heure de Paris, 00-setup.yaml), après les sauvegardes
# (01:00) et le redémarrage automatique (04:00).
[Unit]
Description=Weekly CrowdSec summary to ntfy

[Timer]
OnCalendar={{ pangolin_crowdsec_summary_on_calendar }}
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
