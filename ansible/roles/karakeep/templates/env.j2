# Variables d'environnement de Karakeep : toutes celles que lit le serveur,
# celles en commentaire à leur valeur par défaut (décommenter pour changer).
# Source, à reprendre à chaque montée de version (les défauts suivent main,
# pas forcément l'image épinglée dans compose.yaml) :
#   https://github.com/karakeep-app/karakeep/blob/main/packages/shared/config.ts
#   https://github.com/karakeep-app/karakeep/blob/main/packages/plugins/search-meilisearch/src/env.ts
#   https://github.com/karakeep-app/karakeep/blob/main/packages/plugins/vectorstore-meilisearch/src/env.ts
#   https://github.com/karakeep-app/karakeep/blob/main/packages/plugins/queue-restate/src/env.ts
# Description de chacune :
#   https://github.com/karakeep-app/karakeep/blob/main/docs/docs/03-configuration/01-environment-variables.md
#
# MEILI_ADDR, BROWSER_WEB_URL et DATA_DIR sont fixées dans compose.yaml
# (`environment:` l'emporte sur ce fichier) : elles dépendent des noms de
# conteneurs et des volumes, pas d'un réglage.

TZ=Europe/Paris

# --- Serveur et workers ------------------------------------------------------
# PORT=3000
# Métriques Prometheus des workers sur /metrics ; 0 = port aléatoire.
# WORKERS_HOST=127.0.0.1
# WORKERS_PORT=0
# Listes séparées par des virgules (crawler,inference,search,adminMaintenance,
# video,feed,assetPreprocessing,webhook,ruleEngine,backup).
# WORKERS_ENABLED_WORKERS=
# WORKERS_DISABLED_WORKERS=
# API_URL=http://localhost:3000

# --- Authentification --------------------------------------------------------
NEXTAUTH_URL=https://{{ karakeep_domain }}
NEXTAUTH_SECRET={{ karakeep_nextauth_secret }}
# AUTH_TRUSTED_ORIGINS=*
DISABLE_SIGNUPS={{ karakeep_disable_signups | lower }}
# DISABLE_PASSWORD_AUTH=false
# EMAIL_VERIFICATION_REQUIRED=false
# OAUTH_WELLKNOWN_URL=
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_SCOPE=openid email profile
# client_secret_basic ou client_secret_post.
# OAUTH_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
# OAUTH_PROVIDER_NAME=Custom Provider
# OAUTH_AUTO_REDIRECT=false
# OAUTH_ALLOW_DANGEROUS_EMAIL_ACCOUNT_LINKING=false
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Inférence (tags et résumés automatiques) --------------------------------
# Sans OPENAI_API_KEY ni OLLAMA_BASE_URL, l'inférence est désactivée.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_PROXY_URL=
# OPENAI_TIMEOUT_SEC=
# auto, default ou flex.
# OPENAI_SERVICE_TIER=
# none, minimal, low, medium, high ou xhigh.
# OPENAI_REASONING_EFFORT=
# OLLAMA_BASE_URL=
# OLLAMA_KEEP_ALIVE=
# INFERENCE_TEXT_MODEL=gpt-6-luna
# INFERENCE_IMAGE_MODEL=gpt-4o-mini
# INFERENCE_LANG=english
# INFERENCE_JOB_TIMEOUT_SEC=30
# INFERENCE_FETCH_TIMEOUT_SEC=300
# INFERENCE_CONTEXT_LENGTH=2048
# INFERENCE_MAX_OUTPUT_TOKENS=2048
# Non défini : true avec l'API OpenAI par défaut, false sinon.
# INFERENCE_USE_MAX_COMPLETION_TOKENS=
# structured, json ou plain.
# INFERENCE_OUTPUT_SCHEMA=structured
# Déprécié, remplacé par INFERENCE_OUTPUT_SCHEMA.
# INFERENCE_SUPPORTS_STRUCTURED_OUTPUT=
# INFERENCE_ENABLE_AUTO_TAGGING=true
# INFERENCE_ENABLE_AUTO_SUMMARIZATION=false
# INFERENCE_NUM_WORKERS=1
# CHAT_ENABLED=false
# Non défini : INFERENCE_TEXT_MODEL.
# CHAT_MODEL=

# --- Embeddings et recherche sémantique --------------------------------------
# SEMANTIC_SEARCH_ENABLED=true
# Non défini : true avec l'API OpenAI par défaut, false sinon.
# EMBEDDING_ENABLE_AUTO_INDEXING=
# EMBEDDING_OPENAI_API_KEY=
# EMBEDDING_OPENAI_BASE_URL=
# EMBEDDING_TEXT_MODEL=text-embedding-3-small
# Doit être égal à EMBEDDING_DIMENSIONS s'il est défini.
# EMBEDDING_TEXT_MODEL_DIMENSION_OVERRIDE=
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_CONTEXT_LENGTH=8000
# EMBEDDING_NUM_WORKERS=1
# EMBEDDING_JOB_TIMEOUT_SEC=60

# --- OCR ---------------------------------------------------------------------
# OCR_CACHE_DIR=
# Langues Tesseract séparées par des virgules (ex. eng,fra).
# OCR_LANGS=eng
# OCR_CONFIDENCE_THRESHOLD=50
# OCR_USE_LLM=false

# --- Crawler -----------------------------------------------------------------
# CRAWLER_HEADLESS_BROWSER=true
# BROWSER_WEBSOCKET_URL=
# BROWSER_CONNECT_ONDEMAND=false
# BROWSER_COOKIE_PATH=
# CRAWLER_NUM_WORKERS=1
# CRAWLER_JOB_TIMEOUT_SEC=60
# CRAWLER_NAVIGATE_TIMEOUT_SEC=30
# CRAWLER_CHALLENGE_WAIT_SEC=15
# Fuseau IANA présenté aux sites ; non défini : celui du navigateur.
# CRAWLER_BROWSER_TIMEZONE=
# CRAWLER_DOWNLOAD_BANNER_IMAGE=true
# CRAWLER_STORE_SCREENSHOT=true
# CRAWLER_FULL_PAGE_SCREENSHOT=false
# CRAWLER_SCREENSHOT_TIMEOUT_SEC=5
# CRAWLER_STORE_PDF=false
# CRAWLER_FULL_PAGE_ARCHIVE=false
# 0 = pas de plafond.
# CRAWLER_FULL_PAGE_ARCHIVE_MAX_SIZE_MB=0
# CRAWLER_MONOLITH_TIMEOUT_SEC=5
# Arguments monolith en plus, séparés par %%.
# CRAWLER_MONOLITH_ARGS=
# CRAWLER_ENABLE_ADBLOCKER=true
# CRAWLER_ENABLE_AUTOCONSENT=true
# CRAWLER_PARSER_MEM_LIMIT_MB=512
# CRAWLER_PARSE_TIMEOUT_SEC=60
# CRAWLER_IP_VALIDATION_DNS_RESOLVER_TIMEOUT_SEC=1
# CRAWLER_DOMAIN_RATE_LIMIT_WINDOW_MS=
# CRAWLER_DOMAIN_RATE_LIMIT_MAX_REQUESTS=
# CRAWLER_PREFLIGHT_USER_AGENT=
# Listes séparées par des virgules.
# CRAWLER_HTTP_PROXY=
# CRAWLER_HTTPS_PROXY=
# CRAWLER_NO_PROXY=
# CRAWLER_ALLOWED_INTERNAL_HOSTNAMES=

# Vidéos des liens (signets X, reels Instagram…) téléchargées par yt-dlp au
# crawl et stockées comme asset du bookmark. Désactivé par défaut côté
# Karakeep ; le plafond par vidéo borne ce qui atterrit sur le disque
# rotatif et dans Borg.
CRAWLER_VIDEO_DOWNLOAD={{ karakeep_video_download | lower }}
CRAWLER_VIDEO_DOWNLOAD_MAX_SIZE={{ karakeep_video_download_max_size_mb }}
# CRAWLER_VIDEO_DOWNLOAD_TIMEOUT_SEC=600
# Arguments yt-dlp en plus, séparés par %% : YouTube est exclu (la playlist
# « À regarder plus tard » ne garde que les liens), X/Instagram passent.
CRAWLER_YTDLP_ARGS={{ karakeep_ytdlp_args | join('%%') }}

# --- Autres workers ----------------------------------------------------------
# SEARCH_NUM_WORKERS=1
# SEARCH_JOB_TIMEOUT_SEC=30
# ASSET_PREPROCESSING_NUM_WORKERS=1
# ASSET_PREPROCESSING_JOB_TIMEOUT_SEC=60
# RULE_ENGINE_NUM_WORKERS=1
# WEBHOOK_NUM_WORKERS=1
# WEBHOOK_TIMEOUT_SEC=5
# WEBHOOK_RETRY_TIMES=3

# --- Meilisearch -------------------------------------------------------------
MEILI_MASTER_KEY={{ karakeep_meili_master_key }}
# MEILI_BATCH_SIZE=50
# MEILI_BATCH_TIMEOUT_MS=500
# Instance séparée pour les vecteurs ; non défini : MEILI_ADDR / MEILI_MASTER_KEY.
# MEILI_VECTOR_ADDR=
# MEILI_VECTOR_MASTER_KEY=

# --- Stockage ----------------------------------------------------------------
# Non défini : $DATA_DIR/assets.
# ASSETS_DIR=
# MAX_ASSET_SIZE_MB=50
# HTML_CONTENT_SIZE_INLINE_THRESHOLD_BYTES=5120
# DB_WAL_MODE=false
# Assets sur S3 plutôt que sur disque.
# ASSET_STORE_S3_ENDPOINT=
# ASSET_STORE_S3_REGION=
# ASSET_STORE_S3_BUCKET=
# ASSET_STORE_S3_ACCESS_KEY_ID=
# ASSET_STORE_S3_SECRET_ACCESS_KEY=
# ASSET_STORE_S3_FORCE_PATH_STYLE=false

# --- Limites -----------------------------------------------------------------
# MAX_RSS_FEEDS_PER_USER=1000
# MAX_WEBHOOKS_PER_USER=100
# RATE_LIMITING_ENABLED=false
# REDIS_URL=

# --- Email -------------------------------------------------------------------
# SMTP : même compte Infomaniak que dawarich / meerkat_crm (mot de passe
# oublié, vérification d'email).
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER={{ pangolin_smtp_user }}
SMTP_PASSWORD={{ pangolin_smtp_pass }}
SMTP_FROM={{ pangolin_smtp_user }}

# --- Logs et observabilité ---------------------------------------------------
# LOG_LEVEL=debug
# Toute valeur non vide désactive les couleurs.
# NO_COLOR=
# PROMETHEUS_AUTH_TOKEN=
# OTEL_TRACING_ENABLED=false
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_SERVICE_NAME=karakeep
# OTEL_SAMPLE_RATE=1.0
# EVENT_LOGS_ENABLED=false
# OTEL_EVENT_LOGS_EXPORT_ENABLED=false
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=

# --- Divers ------------------------------------------------------------------
# DISABLE_NEW_RELEASE_CHECK=false
# DEGRADED_MODE=false
# TERMS_OF_SERVICE_URL=
# PRIVACY_POLICY_URL=

# --- Hébergement cloud, démo, build : sans objet ici -------------------------
# DEMO_MODE=false
# DEMO_MODE_EMAIL=
# DEMO_MODE_PASSWORD=
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
# STRIPE_YEARLY_PRICE_ID=
# FREE_QUOTA_BOOKMARK_LIMIT=
# FREE_QUOTA_ASSET_SIZE_BYTES=
# FREE_BROWSER_CRAWLING_ENABLED=
# PAID_QUOTA_BOOKMARK_LIMIT=
# PAID_QUOTA_ASSET_SIZE_BYTES=
# PAID_BROWSER_CRAWLING_ENABLED=
# SERVER_VERSION=
# CHANGELOG_VERSION=
# USING_LEGACY_SEPARATE_CONTAINERS=false
# File de jobs Restate (alternative à la file SQLite intégrée).
# RESTATE_LISTEN_PORT=
# RESTATE_INGRESS_ADDR=http://localhost:8080
# RESTATE_ADMIN_ADDR=http://localhost:9070
# RESTATE_PUB_KEY=
# RESTATE_EXPOSE_CORE_SERVICES=true
# RESTATE_ENABLE_DISPATCHERS=true
# RESTATE_ENABLE_RUNNERS=true
# RESTATE_DISPATCHER_INACTIVITY_TIMEOUT_SECS=10
