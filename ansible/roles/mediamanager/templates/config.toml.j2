# Configuration de MediaManager, générée par le rôle mediamanager (nas.yml) :
# toute modification ici est écrasée au prochain déploiement. Référence :
# https://maxdorninger.github.io/MediaManager/configuration/

[misc]
frontend_url = {{ mediamanager_frontend_url | to_json }}
cors_urls = {{ mediamanager_cors_urls | to_json }}
# Bac à sable monté en /data (un seul montage, liens physiques possibles),
# affiches hors des médias.
image_directory = "/images"
movie_directory = "/data/films"
tv_directory = "/data/series"
torrent_directory = "/data/torrents"
development = false

[database]
host = "db"
port = 5432
user = "mediamanager"
password = {{ mediamanager_db_password | to_json }}
dbname = "mediamanager"

[auth]
token_secret = {{ mediamanager_token_secret | to_json }}
session_lifetime = 86400
email_password_resets = false
# Le premier compte, créé au premier démarrage avec le mot de passe « admin »
# (à changer aussitôt), et tout compte inscrit avec cette adresse.
admin_emails = [{{ mediamanager_admin_email | to_json }}]

[auth.openid_connect]
enabled = false

[torrents.qbittorrent]
# Derrière gluetun (network_mode: service:gluetun) : joint par le nom du
# service gluetun sur le réseau du projet. Coupé tant que le VPN n'est pas
# configuré : qBittorrent n'existe pas alors.
enabled = {{ mediamanager_vpn_enabled | bool | lower }}
host = "http://gluetun"
port = {{ mediamanager_qbittorrent_webui_port }}
username = {{ mediamanager_qbittorrent_username | to_json }}
password = {{ mediamanager_qbittorrent_password | to_json }}
category_name = "MediaManager"
# Même chemin que torrent_directory, vu de qBittorrent (même montage /data).
category_save_path = "/data/torrents"

[indexers.prowlarr]
# Derrière gluetun aussi : ses recherches partent par le tunnel.
enabled = {{ mediamanager_vpn_enabled | bool | lower }}
url = "http://gluetun:{{ mediamanager_prowlarr_port }}"
api_key = {{ mediamanager_prowlarr_api_key | to_json }}
timeout_seconds = 60

# Écarte les enregistrements au cinéma et les sorties « nuked ».
[[indexers.title_scoring_rules]]
name = "avoid_cam"
keywords = ["cam", "camrip", "hdcam", "telesync", "hdts"]
score_modifier = -10000
negate = false

[[indexers.indexer_flag_scoring_rules]]
name = "reject_nuked"
flags = ["nuked"]
score_modifier = -10000
negate = false

[[indexers.scoring_rule_sets]]
name = "default"
libraries = ["ALL_TV", "ALL_MOVIES"]
rule_names = ["avoid_cam", "reject_nuked"]

[metadata.tmdb]
tmdb_relay_url = "https://metadata-relay.dorninger.co/tmdb"
primary_languages = {{ mediamanager_tmdb_primary_languages | to_json }}
default_language = {{ mediamanager_tmdb_default_language | to_json }}

[metadata.tvdb]
tvdb_relay_url = "https://metadata-relay.dorninger.co/tvdb"
