[DEFAULT]
bantime = 3600
findtime = 600
maxretry = 3
destemail = root@localhost

# Debian 13 n'a pas de rsyslog, donc pas de /var/log/auth.log : sshd se lit
# dans le journal. jail.d/defaults-debian.conf le fait déjà, on ne compte pas
# dessus.
[sshd]
enabled = true
backend = systemd
port = 22
maxretry = 3
bantime = 7200
