# {{ ansible_managed }}
# Hôtes sans devsec.hardening seulement (security_devsec_enabled: false).
PasswordAuthentication no
PubkeyAuthentication yes
KbdInteractiveAuthentication no
PermitRootLogin no
AllowUsers {{ security_ssh_allow_users }}
MaxAuthTries {{ security_ssh_max_auth_tries }}
MaxSessions 2
ClientAliveInterval 600
ClientAliveCountMax 2
X11Forwarding no
AllowTcpForwarding {{ security_ssh_allow_tcp_forwarding }}
AllowAgentForwarding {{ 'yes' if security_ssh_allow_agent_forwarding | bool else 'no' }}
PermitEmptyPasswords no
UsePAM yes
LogLevel VERBOSE
