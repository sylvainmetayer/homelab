# {{ ansible_managed }}
# Lu (source) par {{ ssh_login_notify_script }}. 0600 root : l'URL porte le
# jeton du moniteur push.
PUSH_URL={{ ssh_login_notify_push_url | quote }}
PUSH_TIMEOUT={{ ssh_login_notify_timeout | int }}
# Un commentaire de clé par ligne.
IGNORED_KEYS={{ ssh_login_notify_ignored_keys | join('\n') | quote }}
