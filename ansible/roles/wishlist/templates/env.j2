# URL publique : SvelteKit refuse les formulaires (CSRF) dont l'Origin diffère,
# et les liens d'invitation et de partage en sont dérivés.
ORIGIN=https://{{ wishlist_domain }}
TOKEN_TIME={{ wishlist_token_time }}
DEFAULT_CURRENCY={{ wishlist_default_currency }}
LOG_LEVEL=info
# Pas d'ALLOWED_IPS : la lecture des pages produit (scraping) refuse par
# défaut toute adresse privée, donc les autres conteneurs du réseau newt.
# Pas d'HEADER_AUTH_ENABLED non plus : l'application croirait n'importe quel
# en-tête d'identité, et les chemins du lien public (website_wishlist.tf)
# passent sans le SSO de Pangolin.
