# {{ ansible_managed }}
# Remplissage du thin pool LVM (rôle thin_pool_check), poussé au moniteur
# « Thin pool Proxmox » d'Uptime Kuma. L'URL push (jeton du moniteur) est dans
# l'EnvironmentFile, 0600 root : ni la ligne de commande ni systemctl show ne
# la montrent.
[Unit]
Description=Check the fill level of the LVM thin pool
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile={{ thin_pool_check_dir }}/thin-pool-check.env
Environment=UPTIME_PUSH={{ uptime_push_bin }}
ExecStart=/bin/sh {{ thin_pool_check_dir }}/thin-pool-check.sh {{ thin_pool_check_threshold | int }}
TimeoutStartSec=2min
NoNewPrivileges=yes
ProtectSystem=strict
# lvs pose son verrou dans /run/lock/lvm : sans lui, « File locking initialisation failed ».
ReadWritePaths=-/run/lock/lvm
ProtectHome=yes
PrivateTmp=yes
