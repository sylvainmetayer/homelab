# Static fallback inventory
# Use this if dynamic inventory is not working or for testing

# [proxmox]
# debian-base ansible_host=192.168.1.100 ansible_user=bob

# [pangolin]
# Pangolin Zero Trust server
# Dynamic inventory is provided by hetzner.py
# Add your Pangolin host here manually only if dynamic inventory is not working
# Example:
# pangolin ansible_host=pangolin.example.com ansible_user=sylvain

[raspberrypi]
pi ansible_host=192.168.1.96 ansible_user=sylvain

# LXC de Proxmox qui fait tourner le Newt du site proxmox-lxc (lxc.yml) : la CI
# et les ressources privées du LAN passent par lui. Absent de proxmox.py, qui
# ne lit que les VM.
[newt_lxc]
newt-lxc ansible_host=192.168.1.200 ansible_user=sylvain

# NAS Ugreen DXP2800 (UGOS Pro) : nas.yml uniquement, lancé à la main. Exclu
# de 00-setup.yaml : le système appartient à UGOS.
[ugreen]
nas ansible_host=192.168.1.137 ansible_user=sylvain

# Hôte Proxmox VE : pve.yml uniquement (agent Beszel), lancé à la main. Exclu
# de 00-setup.yaml : le système appartient à Proxmox, géré par tofu/proxmox
# (API et SSH root). Connexion en root sans become : host_vars/pve. Groupe
# proxmox_ve, pas pve : un groupe du nom de l'hôte fait avertir Ansible.
[proxmox_ve]
pve ansible_host=192.168.1.26
