# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Ignore override files as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Les .terraform.lock.hcl sont versionnés, dans chaque module : ne pas les
# ignorer (un module sans lock a déjà rendu le state de tofu/pangolin illisible,
# #896). Le Lint (init -lockfile=readonly) refuse un lock en retard.

# Extension SOPS, just in case
.decrypted*.yaml

# If debugging state
state.json

# Scratch notes and debug logs (TF_LOG output was once committed as wip.txt)
wip.txt

# Secret variable files for Proxmox
*.tfvars.secret

ansible/galaxy_roles
ansible/collections
ansible/run.log
ansible/facts/

.ansible/
.venv/

issue.md

# Python bytecode (Ansible parses every file in inventory/ as a source)
__pycache__/
*.py[cod]

# mkdocs build (mkdocs.yml, rôle docs_site)
/site/
