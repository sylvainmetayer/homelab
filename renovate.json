{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchCategories": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "description": "Group all Pangolin role dependencies together",
      "groupName": "pangolin-role-dependencies",
      "matchFileNames": [
        "ansible/roles/pangolin/**",
        "ansible/roles/newt/**"
      ]
    },
    {
      "description": "Pangolin's Docker tags are prefixed with ee- (e.g. ee-1.21.0); teach Renovate to parse them as semver so EE updates are detected",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "docker.io/fosrl/pangolin"
      ],
      "versioning": "regex:^ee-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "Group all Immich role dependencies together",
      "groupName": "immich-role-dependencies",
      "matchFileNames": [
        "ansible/roles/immich/**",
        "compose/immich/**"
      ]
    }
  ]
}
