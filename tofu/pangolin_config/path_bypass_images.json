{
  "Dawarich": {
    "image": "freikin/dawarich",
    "version": "1.19.0",
    "compose": "ansible/roles/dawarich/templates/compose.yaml",
    "paths": "tofu/pangolin_config/website_dawarich.tf (dawarich_share_paths)",
    "reread": "config/routes.rb, app/controllers/shared/*, app/controllers/api/v1/shared/*",
    "releases": "https://github.com/Freika/dawarich/releases"
  },
  "Karakeep": {
    "image": "ghcr.io/karakeep-app/karakeep",
    "version": "0.34.1",
    "compose": "ansible/roles/karakeep/templates/compose.yaml",
    "paths": "tofu/pangolin_config/website_karakeep.tf (karakeep_public_paths)",
    "reread": "apps/web/app/public, apps/web/components/public/lists, packages/api",
    "releases": "https://github.com/karakeep-app/karakeep/releases"
  },
  "Monica CRM": {
    "image": "monica",
    "version": "3.7.0-apache",
    "compose": "ansible/roles/monica_v4/templates/compose.yaml",
    "paths": "tofu/pangolin_config/website_monica.tf (monica_dav_paths)",
    "reread": "config/laravelsabre.php, AuthenticateWithTokenOnBasicAuth, routes/web.php (.well-known)",
    "releases": "https://github.com/monicahq/monica/releases"
  },
  "nextcloud": {
    "image": "ghcr.io/linuxserver/nextcloud",
    "version": "35.0.2",
    "compose": "ansible/roles/nextcloud/templates/compose.yaml",
    "paths": "tofu/pangolin_config/website_nextcloud.tf (nextcloud_client_paths, nextcloud_share_paths)",
    "reread": "server: core/routes.php, apps/*/appinfo/routes.php of files_sharing, files, files_trashbin, files_versions, theming, text, files_pdfviewer, core/ajax (never opened); linuxserver root/defaults/nginx/site-confs/default.conf.sample (front controller, .well-known); clients: desktop src/libsync + src/gui/wizard, Android ConnectivityServiceImpl.kt, NextcloudKit, DAVx5",
    "releases": "https://github.com/nextcloud/server/releases"
  },
  "ntfy": {
    "image": "docker.io/binwiederhier/ntfy",
    "version": "v2.34.0",
    "compose": "ansible/roles/ntfy/templates/compose.yaml",
    "paths": "tofu/pangolin_config/website_ntfy.tf (ntfy_client_paths)",
    "reread": "server/server.go (handleInternal and the path regexes above it: every route answering /, /<topic>, /<topic>/json|ws|auth, and which of them skip authorizeTopic*), server/server_middleware.go (authorizeTopicRead/Write), server/server_account.go and server/server_admin.go (nothing under /v1 opened), user/manager.go (auth-default-access deny-all, provisioned users and tokens); the clients: ntfy-android ApiService.kt, WsConnection.kt and util/Util.kt, ntfy-ios ntfy/Utils/ApiService.swift and Helpers.swift, Uptime Kuma server/notification-providers/ntfy.js, shoutrrr pkg/services/push/ntfy",
    "releases": "https://github.com/binwiederhier/ntfy/releases"
  },
  "Paperless-ngx": {
    "image": "ghcr.io/paperless-ngx/paperless-ngx",
    "version": "3.3",
    "compose": "ansible/roles/paperless_ngx/templates/compose.yaml",
    "paths": "tofu/pangolin_config/website_paperless.tf (paperless_share_paths)",
    "reread": "src/paperless/urls.py, src/documents/views.py (SharedLinkView)",
    "releases": "https://github.com/paperless-ngx/paperless-ngx/releases"
  },
  "TREK": {
    "image": "docker.io/mauriceboe/trek",
    "version": "5.0.0",
    "compose": "ansible/roles/trek/templates/compose.yaml",
    "paths": "tofu/pangolin_config/website_trek.tf (trek_mcp_public_paths, trek_share_paths)",
    "reread": "server/src/nest/{mcp-transport,oauth,platform}, share.service.ts, journey-share.service.ts, client /app/server/public",
    "releases": "https://github.com/liketrek/TREK/releases"
  },
  "Wishlist": {
    "image": "ghcr.io/cmintey/wishlist",
    "version": "v0.69.0",
    "compose": "ansible/roles/wishlist/templates/compose.yaml",
    "paths": "tofu/pangolin_config/website_wishlist.tf (wishlist_public_paths)",
    "reread": "src/routes/lists (all of it: /lists/* also matches /lists, /lists/create), src/routes/api/{lists,users/public,assets}, src/lib/api, src/hooks.server.ts, svelte.config.js and any *.remote.ts (served under /_app/remote), Caddyfile",
    "releases": "https://github.com/cmintey/wishlist/releases"
  }
}
